def get_env_with_extra_paths() -> Dict[str, str]:
    """Ensure standard user binary directories & proxy environment variables are in PATH."""
    env = os.environ.copy()
    current_path = env.get("PATH", "")
    extra_dirs = [
        str(Path.home() / ".local" / "bin"),
        str(Path.home() / ".bun" / "bin"),
        str(Path.home() / ".grok" / "bin"),
        str(Path.home() / ".cargo" / "bin"),
        "/opt/homebrew/bin",
        "/usr/local/bin",
    ]
    path_parts = current_path.split(":") if current_path else []
    for d in extra_dirs:
        if d not in path_parts and os.path.isdir(d):
            path_parts.insert(0, d)
    env["PATH"] = ":".join(path_parts)
    return env

def find_executable(candidates: List[str]) -> Optional[str]:
    env = get_env_with_extra_paths()
    for cand in candidates:
        expanded = os.path.expanduser(cand)
        if os.path.isabs(expanded) and os.path.isfile(expanded) and os.access(expanded, os.X_OK):
            return expanded
        which_path = shutil.which(cand, path=env.get("PATH"))
        if which_path:
            return which_path
    return None

def extract_clean_version(raw: str) -> str:
    """Extract clean semver / version string from command output."""
    raw = raw.strip()
    if not raw:
        return "unknown"
    m = re.search(r"(?:^|[\s/vV:])(\d+\.\d+(?:\.\d+)?(?:-[a-zA-Z0-9.]+)?(?:\+[a-zA-Z0-9.]+)?)\b", raw)
    if m:
        return m.group(1)
    first_line = raw.splitlines()[0].strip()
    return first_line[:30]

def query_harness_version(cfg: Dict[str, Any]) -> Tuple[Optional[str], str]:
    """Returns (clean_version, raw_output)."""
    bin_path = find_executable(cfg["binary_candidates"])
    if not bin_path:
        return None, "Binary not found"
    
    cmd = [bin_path] + cfg["version_cmd"][1:]
    try:
        res = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=15,
            env=get_env_with_extra_paths()
        )
        output = (res.stdout or res.stderr).strip()
        if res.returncode == 0 or output:
            return extract_clean_version(output), output
        return None, f"Exit code {res.returncode}: {output}"
    except Exception as e:
        return None, str(e)

def smoke_test_harness(cfg: Dict[str, Any]) -> Tuple[bool, str]:
    """Runs a non-destructive post-update verification guard."""
    bin_path = find_executable(cfg["binary_candidates"])
    if not bin_path:
        return False, "Binary not found after update"
    
    smoke_cmd = [bin_path] + cfg.get("smoke_cmd", ["--help"])[1:]
    try:
        res = subprocess.run(
            smoke_cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=10,
            env=get_env_with_extra_paths()
        )
        if res.returncode == 0:
            return True, "Smoke test passed"
        return False, f"Smoke command returned exit code {res.returncode}"
    except Exception as e:
        return False, f"Smoke test exception: {e}"

def send_desktop_notification(title: str, message: str) -> None:
    """Dispatches a native desktop notification on macOS or Linux."""
    try:
        # macOS notification via AppleScript
        if shutil.which("osascript") and sys.platform == "darwin":
            clean_title = title.replace('"', '\\"')
            clean_msg = message.replace('"', '\\"')
            script = f'display notification "{clean_msg}" with title "{clean_title}" subtitle "UCA Auto-Updater"'
            subprocess.run(["osascript", "-e", script], capture_output=True, timeout=5)
            return

        # Linux notification via notify-send
        if shutil.which("notify-send"):
            subprocess.run(
                ["notify-send", title, message, "-a", "UCA", "-i", "system-software-update"],
                capture_output=True,
                timeout=5
            )
            return
    except Exception:
        pass

def load_state() -> Dict[str, Any]:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if STATE_FILE.exists():
        try:
            with open(STATE_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {
        "version": 1,
        "last_run_at": None,
        "last_run_duration_secs": 0.0,
        "last_run_status": None,
        "most_recently_updated": None,
        "harnesses": {},
    }

def save_state(state: Dict[str, Any]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp_file = STATE_DIR / f"state.json.tmp.{os.getpid()}"
    try:
        with open(tmp_file, "w", encoding="utf-8") as f:
            json.dump(state, f, indent=2)
        os.replace(tmp_file, STATE_FILE)
    except Exception as e:
        if tmp_file.exists():
            try:
                tmp_file.unlink()
            except Exception:
                pass
        raise e

def format_relative_time(iso_str: Optional[str]) -> str:
    if not iso_str:
        return "Never"
    try:
        dt = datetime.fromisoformat(iso_str)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        now = datetime.now(timezone.utc)
        diff = now - dt
        total_seconds = max(0, int(diff.total_seconds()))
        
        if total_seconds < 60:
            return f"{total_seconds}s ago"
        minutes = total_seconds // 60
        if minutes < 60:
            return f"{minutes}m ago"
        hours = minutes // 60
        if hours < 24:
            return f"{hours}h ago"
        days = hours // 24
        if days == 1:
            return "yesterday"
        if days < 30:
            return f"{days}d ago"
        return dt.strftime("%b %d, %Y")
    except Exception:
        return str(iso_str)[:19]

def execute_update_cmd(cmd_list: List[str], timeout: int = 300) -> Tuple[int, str]:
    """Executes an update command with timeout and environment."""
    env = get_env_with_extra_paths()
    try:
        res = subprocess.run(
            cmd_list,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=timeout,
            env=env,
        )
        return res.returncode, res.stdout or ""
    except subprocess.TimeoutExpired:
        return 124, f"Command timed out after {timeout}s"
    except Exception as e:
        return 1, str(e)

def update_single_harness(
    cfg: Dict[str, Any],
    harness_state: Dict[str, Any],
    quiet: bool = False,
    dry_run: bool = False,
    smoke_test: bool = True,
) -> Tuple[Dict[str, Any], Optional[Dict[str, Any]]]:
    key = cfg["key"]
    name = cfg["name"]
    now_iso = datetime.now(timezone.utc).isoformat()
    
    bin_path = find_executable(cfg["binary_candidates"])
    if not bin_path:
        if not quiet:
            print(f"  {c('•', ANSI.GRAY)} {pad_str(c(name, ANSI.BOLD), 20)} {c('Not installed', ANSI.GRAY)} (skipped)")
        harness_state["installed"] = False
        harness_state["last_status"] = "not_installed"
        harness_state["last_checked_at"] = now_iso
        return harness_state, None

    harness_state["installed"] = True
    harness_state["binary_path"] = bin_path
    
    # Query version before update
    v_before, _ = query_harness_version(cfg)
    if not v_before:
        v_before = harness_state.get("current_version") or "unknown"
    
    if dry_run:
        if not quiet:
            print(f"  {c('•', ANSI.BLUE)} {pad_str(c(name, ANSI.BOLD), 20)} {c('[DRY-RUN]', ANSI.YELLOW)} Current: {v_before}")
        return harness_state, None

    if not quiet:
        print(f"  {c('⟳', ANSI.BLUE)} Updating {c(name, ANSI.BOLD)}...", end="", flush=True)

    start_time = time.time()
    
    # Determine update command
    update_cmd = list(cfg["update_cmd"])
    first_tok = find_executable([update_cmd[0]])
    if first_tok:
        update_cmd[0] = first_tok
    elif "fallback_update_cmd" in cfg:
        fallback_tok = find_executable([cfg["fallback_update_cmd"][0]])
        if fallback_tok:
            update_cmd = [fallback_tok] + cfg["fallback_update_cmd"][1:]

    ret_code, output = execute_update_cmd(update_cmd)
    duration = time.time() - start_time
    
    # Query version after update
    v_after, _ = query_harness_version(cfg)
    if not v_after:
        v_after = v_before

    # Smoke Test Verification Guard
    smoke_passed = True
    smoke_msg = ""
    if smoke_test and ret_code == 0 and bin_path:
        smoke_passed, smoke_msg = smoke_test_harness(cfg)

    version_changed = (v_before != "unknown" and v_after != "unknown" and v_before != v_after)
    change_event = None

    harness_state["last_checked_at"] = now_iso
    harness_state["last_duration_secs"] = round(duration, 2)
    harness_state["smoke_test_passed"] = smoke_passed

    if "history" not in harness_state:
        harness_state["history"] = []

    if version_changed:
        change_event = {
            "key": key,
            "name": name,
            "timestamp": now_iso,
            "from_version": v_before,
            "to_version": v_after,
            "duration_secs": round(duration, 2),
            "status": "success" if (ret_code == 0 and smoke_passed) else "updated_with_warning",
        }
        harness_state["previous_version"] = v_before
        harness_state["current_version"] = v_after
        harness_state["last_updated_at"] = now_iso
        harness_state["last_version_change"] = {
            "from_version": v_before,
            "to_version": v_after,
            "timestamp": now_iso,
        }
        harness_state["last_status"] = "updated" if smoke_passed else "smoke_warning"
        harness_state["history"].insert(0, change_event)
        harness_state["history"] = harness_state["history"][:50]
        
        if not quiet:
            smoke_tag = "" if smoke_passed else f" {c('[Smoke Test Warning: ' + smoke_msg + ']', ANSI.YELLOW)}"
            print(f"\r  {c('🎉', ANSI.GREEN)} {pad_str(c(name, ANSI.BOLD), 20)} {c('UPDATED', ANSI.GREEN, ANSI.BOLD)}: From version {c(v_before, ANSI.YELLOW)} to version {c(v_after, ANSI.GREEN, ANSI.BOLD)} ({duration:.1f}s){smoke_tag}")
    else:
        harness_state["current_version"] = v_after
        if "previous_version" not in harness_state or not harness_state["previous_version"]:
            harness_state["previous_version"] = v_after
            
        if ret_code == 0 and smoke_passed:
            harness_state["last_status"] = "up_to_date"
            if not quiet:
                print(f"\r  {c('✔', ANSI.GREEN)} {pad_str(c(name, ANSI.BOLD), 20)} {c('Up to date', ANSI.GREEN)} ({v_after}) ({duration:.1f}s)")
        else:
            harness_state["last_status"] = "error"
            err_detail = smoke_msg if not smoke_passed else (output.splitlines()[-1] if output else "Update command failed")
            harness_state["last_error"] = err_detail
            if not quiet:
                print(f"\r  {c('⚠️', ANSI.YELLOW)} {pad_str(c(name, ANSI.BOLD), 20)} {c('Update Warning', ANSI.YELLOW)} ({v_after}) - {err_detail}")

    return harness_state, change_event

def run_all_updates(
    target_keys: Optional[List[str]] = None,
    quiet: bool = False,
    dry_run: bool = False,
    notify: bool = True,
    smoke_test: bool = True,
) -> int:
    with AtomicLock(LOCK_DIR):
        state = load_state()
        start_total = time.time()
        now_iso = datetime.now(timezone.utc).isoformat()
        
        configs_to_run = HARNESS_CONFIGS
        if target_keys:
            configs_to_run = [c for c in HARNESS_CONFIGS if c["key"] in target_keys]
            if not configs_to_run:
                print(c(f"Error: No matching harness for {target_keys}", ANSI.RED))
                return 1

        if not quiet:
            local_time_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            if has_gum():
                banner = gum_style(
                    "--border", "normal",
                    "--border-foreground", "39",
                    "--padding", "0 1",
                    "--margin", "1 0",
                    f"{gum_style('--foreground', '42', '--bold', text='UCA')} {gum_style('--foreground', '245', text='— Universal Coding Agent Harness Updater')}\n{gum_style('--foreground', '245', text='Started at: ' + local_time_str)}"
                )
                print(banner)
            else:
                print(f"\n{c('═' * 76, ANSI.BLUE)}")
                print(f" {c('UCA', ANSI.BOLD, ANSI.BLUE)} — Universal Coding Agent Harness Updater")
                print(f" {c('Started at:', ANSI.GRAY)} {local_time_str}")
                print(f"{c('═' * 76, ANSI.BLUE)}\n")

        any_updated = False
        has_errors = False
        upgraded_events = []
        
        for cfg in configs_to_run:
            key = cfg["key"]
            h_state = state.get("harnesses", {}).get(key, {
                "key": key,
                "name": cfg["name"],
                "installed": False,
                "current_version": None,
                "previous_version": None,
                "last_checked_at": None,
                "last_updated_at": None,
                "last_status": None,
                "last_version_change": None,
                "history": [],
            })
            
            updated_h_state, change_event = update_single_harness(
                cfg, h_state, quiet=quiet, dry_run=dry_run, smoke_test=smoke_test
            )
            
            if "harnesses" not in state:
                state["harnesses"] = {}
            state["harnesses"][key] = updated_h_state
            
            if change_event:
                any_updated = True
                upgraded_events.append(change_event)
                state["most_recently_updated"] = change_event
            if updated_h_state.get("last_status") in ["error", "smoke_warning"]:
                has_errors = True

        total_duration = time.time() - start_total
        state["last_run_at"] = now_iso
        state["last_run_duration_secs"] = round(total_duration, 2)
        state["last_run_status"] = "error" if has_errors else ("updated" if any_updated else "success")
        
        if not dry_run:
            save_state(state)

        # Dispatch Desktop Notification if harnesses were upgraded
        if notify and upgraded_events:
            if len(upgraded_events) == 1:
                ev = upgraded_events[0]
                send_desktop_notification(
                    f"🚀 {ev['name']} Upgraded",
                    f"From version {ev['from_version']} to {ev['to_version']}"
                )
            else:
                names = ", ".join(e["name"] for e in upgraded_events)
                send_desktop_notification(
                    "🚀 Agent Harnesses Upgraded",
                    f"Updated {len(upgraded_events)} harnesses: {names}"
                )

        if not quiet:
            if has_gum():
                status_txt = gum_style('--foreground', '42', '--bold', text='Completed')
                print(f"\n{gum_style('--foreground', '245', text='Completed in: ' + f'{total_duration:.1f}s')} • {status_txt}")
                if state.get("most_recently_updated"):
                    mru = state["most_recently_updated"]
                    mru_time = format_relative_time(mru.get("timestamp"))
                    print(gum_style("--foreground", "39", "--bold", text=f"Most Recent Update: {mru['name']} (From version {mru['from_version']} to {mru['to_version']}, {mru_time})"))
                print()
            else:
                print(f"\n{c('─' * 76, ANSI.GRAY)}")
                print(f" {c('Completed in:', ANSI.GRAY)} {total_duration:.1f}s • Status: {c('Completed', ANSI.GREEN)}")
                if state.get("most_recently_updated"):
                    mru = state["most_recently_updated"]
                    mru_time = format_relative_time(mru.get("timestamp"))
                    print(f" {c('Most Recent Update:', ANSI.BLUE, ANSI.BOLD)} {mru['name']} (From version {mru['from_version']} to {mru['to_version']}, {mru_time})")
                print(f"{c('═' * 76, ANSI.BLUE)}\n")

        # Append to log file
        try:
            LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
            with open(LOG_FILE, "a", encoding="utf-8") as lf:
                lf.write(f"[{now_iso}] uca run: duration={total_duration:.2f}s, updated={any_updated}, errors={has_errors}\n")
        except Exception:
            pass

        return 1 if has_errors else 0

def check_live_status_parallel() -> Dict[str, Any]:
    """Probes live versions concurrently across thread workers for sub-second latency."""
    state = load_state()
    harnesses_data = {}

    def probe_worker(cfg: Dict[str, Any]) -> Tuple[str, Optional[str], Optional[str]]:
        key = cfg["key"]
        v_live, _ = query_harness_version(cfg)
        bin_path = find_executable(cfg["binary_candidates"])
        return key, v_live, bin_path

    with concurrent.futures.ThreadPoolExecutor(max_workers=len(HARNESS_CONFIGS)) as executor:
        futures = [executor.submit(probe_worker, cfg) for cfg in HARNESS_CONFIGS]
        results = [f.result() for f in concurrent.futures.as_completed(futures)]

    res_map = {r[0]: (r[1], r[2]) for r in results}

    for cfg in HARNESS_CONFIGS:
        key = cfg["key"]
        h_state = state.get("harnesses", {}).get(key, {})
        v_live, bin_path = res_map.get(key, (None, None))
        
        entry = dict(h_state)
        entry["name"] = cfg["name"]
        entry["installed"] = bool(bin_path)
        entry["binary_path"] = bin_path
        if v_live:
            entry["current_version"] = v_live
        harnesses_data[key] = entry
        
    return {
        "state": state,
        "harnesses": harnesses_data,
        "service": get_service_status(),
    }

def get_service_status() -> Dict[str, Any]:
    """Detects systemd user timer or launchd agent."""
    res = {
        "type": "none",
        "active": False,
        "schedule": "every 3 hours",
        "next_run": "unknown",
        "detail": "Not configured",
    }
    
    # Check launchd (macOS)
    if shutil.which("launchctl"):
        res["type"] = "launchd"
        username = os.environ.get("USER") or Path.home().name
        labels_to_check = [f"com.{username}.uca", "com.jemanuel.uca", "com.uca.updater"]
        found_plist = None
        for lbl in labels_to_check:
            cand = LAUNCHD_DIR / f"{lbl}.plist"
            if cand.exists():
                found_plist = cand
                break
                
        if found_plist:
            try:
                r = subprocess.run(
                    ["launchctl", "list"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    timeout=5,
                )
                matched_label = None
                for lbl in labels_to_check:
                    if lbl in r.stdout:
                        matched_label = lbl
                        break
                if matched_label:
                    res["active"] = True
                    detail_extra = ""
                    for line in r.stdout.splitlines():
                        if matched_label in line:
                            parts = line.split()
                            if len(parts) >= 2:
                                exit_code = parts[1]
                                detail_extra = f", last exit: {exit_code}"
                    res["detail"] = f"launchd background service active (every 3 hours / 10800s{detail_extra})"
                else:
                    res["detail"] = "launchd plist installed but not loaded"
            except Exception as e:
                res["detail"] = f"launchctl error: {e}"
        else:
            res["detail"] = "launchd agent not installed"
        return res

    # Check systemd (Linux)
    if shutil.which("systemctl"):
        res["type"] = "systemd"
        try:
            r = subprocess.run(
                ["systemctl", "--user", "is-active", "uca.timer"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=5,
            )
            is_active = r.stdout.strip() == "active"
            res["active"] = is_active
            if is_active:
                t = subprocess.run(
                    ["systemctl", "--user", "list-timers", "uca.timer", "--no-legend"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    timeout=5,
                )
                timer_out = t.stdout.strip()
                if timer_out:
                    parts = timer_out.split()
                    if len(parts) >= 5:
                        res["next_run"] = f"in {parts[2]} ({parts[0]} {parts[1]})"
                res["detail"] = f"systemd timer active (every 3h, next: {res['next_run']})"
            else:
                res["detail"] = "systemd timer installed but inactive"
        except Exception as e:
            res["detail"] = f"systemd error: {e}"
        return res

    return res

