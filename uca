doctor_robot_docs() {
  cat <<EOF
# UCA Doctor — Autonomous Agent Integration Guide

UCA Doctor provides deterministic self-healing and environment diagnostics for AI agent workflows.

## Recommended Invocations:

1. **Fast Health Check (for CI / scripts)**:
   \`uca doctor health\` -> Exits 0 if healthy, 1 if issues found.

2. **Automated Triage (Single-call JSON)**:
   \`uca doctor --robot-triage\` -> Returns findings, suggested fixes, and system health in machine-readable JSON.

3. **Safe Auto-Repair**:
   \`uca doctor --fix\` -> Performs detect-then-fix repairs, routing all disk mutations through backups in \`~/.local/share/uca/.doctor/runs/<run-id>/backups/\`.

4. **Reversible Rollback**:
   \`uca doctor undo latest\` -> Reverts the last repair run byte-for-byte.

## Exit Code Dictionary:
- 0: Healthy / all fixes applied cleanly
- 1: Unremediated findings present
- 2: Partial fix completed
- 3: Fix failed and reverted
- 4: Refused unsafe operation
- 5: Concurrency lock held
EOF
}

run_doctor_suite() {
  local do_fix="${1:-0}" dry_run="${2:-0}" json_mode="${3:-0}" triage_mode="${4:-0}" health_only="${5:-0}"
  local run_dir=""
  local findings=()
  local fixes_planned=()
  local fixes_applied=()

  # 1. DET-LOCK-STALE
  local stale_lock=0
  if [ -d "$LOCK_DIR" ] && [ -f "$LOCK_DIR/pid" ]; then
    local lock_pid
    lock_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "")
    if [ -n "$lock_pid" ] && ! kill -0 "$lock_pid" 2>/dev/null; then
      stale_lock=1
      findings+=("DET-LOCK-STALE: Stale lock directory left by dead PID $lock_pid")
      fixes_planned+=("FIX-LOCK-STALE: Reclaim stale lock directory ($LOCK_DIR)")
    fi
  fi

  # 2. DET-SERVICE-INACTIVE
  local srv_inactive=0 srv_info srv_st srv_msg
  srv_info=$(get_service_status)
  srv_st="${srv_info%%|*}"
  srv_msg="${srv_info##*|}"
  if [ "$srv_st" != "ACTIVE" ]; then
    srv_inactive=1
    findings+=("DET-SERVICE-INACTIVE: 3-hour background auto-updater is not active ($srv_msg)")
    fixes_planned+=("FIX-SERVICE-INACTIVE: Register and enable 3-hour background scheduler")
  fi

  # 3. DET-SYMLINK-BROKEN
  local symlink_broken=0
  if [ ! -L "$HOME/.local/bin/ucas" ] && [ ! -f "$HOME/.local/bin/ucas" ] && [ -f "$HOME/.local/bin/uca" ]; then
    symlink_broken=1
    findings+=("DET-SYMLINK-BROKEN: ucas status symlink is missing from ~/.local/bin")
    fixes_planned+=("FIX-SYMLINK-BROKEN: Create symlink ~/.local/bin/ucas -> ~/.local/bin/uca")
  fi

  # 4. DET-STATE-CORRUPTED
  local state_corrupted=0
  if [ -f "$STATE_FILE" ]; then
    if [ ! -s "$STATE_FILE" ] || ! grep -q "harnesses" "$STATE_FILE" 2>/dev/null; then
      state_corrupted=1
      findings+=("DET-STATE-CORRUPTED: state.json is empty or contains malformed JSON")
      fixes_planned+=("FIX-STATE-CORRUPTED: Back up corrupted state and initialize clean state.json")
    fi
  fi

  # 5. DET-DISK-SPACE
  local free_mb free_gb low_disk=0
  free_mb=$(get_free_disk_mb "$HOME")
  free_gb=$(awk "BEGIN {printf \"%.1f\", $free_mb / 1024}")
  if [ "$free_mb" -lt "$MIN_FREE_DISK_MB" ]; then
    low_disk=1
    findings+=("DET-DISK-SPACE: Low free disk space (${free_mb} MB free, safety threshold: ${MIN_FREE_DISK_MB} MB)")
  fi

  # 6. DET-HARNESS-SMOKE
  local broken_harnesses=()
  for h in "claude" "codex" "agy" "grok" "omp"; do
    local v
    v=$(get_harness_version "$h")
    if [ -n "$v" ] && ! smoke_test_harness "$h"; then
      broken_harnesses+=("$h")
      findings+=("DET-HARNESS-SMOKE: $h failed smoke test / execution verification")
      fixes_planned+=("FIX-HARNESS-SMOKE: Re-run update on $h to repair binary")
    fi
  done

  # 7. DET-PATH-ENV
  local path_env_missing=0
  if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]] && [ -d "$HOME/.local/bin" ]; then
    path_env_missing=1
    findings+=("DET-PATH-ENV: ~/.local/bin is not in current PATH")
    fixes_planned+=("FIX-PATH-ENV: Add ~/.local/bin to PATH configuration in shell rc")
  fi

  # 8. DET-ALIAS-CONFLICT
  local alias_conflict=0
  for rc in "$HOME/.zshrc" "$HOME/.zshrc.local" "$HOME/.bashrc" "$HOME/.bash_aliases"; do
    if [ -f "$rc" ] && grep -q "^[[:space:]]*alias uca=" "$rc" 2>/dev/null; then
      alias_conflict=1
      findings+=("DET-ALIAS-CONFLICT: Conflicting alias uca found in $rc")
      fixes_planned+=("FIX-ALIAS-CONFLICT: Remove alias uca from $rc and ensure unalias uca guard")
    fi
  done

  # Health-only mode
  if [ "$health_only" -eq 1 ]; then
    if [ "${#findings[@]}" -eq 0 ]; then
      echo "OK: UCA environment is healthy (5/5 harnesses ready, background service active, ${free_gb} GB free)"
      return 0
    else
      echo "WARNING: ${#findings[@]} findings detected in UCA environment"
      return 1
    fi
  fi

  # Robot-Triage Mega Command
  if [ "$triage_mode" -eq 1 ] || [ "$json_mode" -eq 1 ]; then
    local status_str="healthy"
    local exit_code=0
    [ "${#findings[@]}" -gt 0 ] && { status_str="findings_detected"; exit_code=1; }
    
    local rec_cmd="uca"
    [ "${#findings[@]}" -gt 0 ] && rec_cmd="uca doctor --fix"

    cat <<EOF
{
  "schema_version": "1.0.0",
  "status": "$status_str",
  "exit_code": $exit_code,
  "summary": {
    "findings_count": ${#findings[@]},
    "actions_planned_count": ${#fixes_planned[@]},
    "free_disk_mb": $free_mb,
    "service_active": $( [ "$srv_st" = "ACTIVE" ] && echo "true" || echo "false" )
  },
  "findings": [
    $(IFS=","; for f in "${findings[@]}"; do printf '"%s",' "$f"; done | sed 's/,$//')
  ],
  "actions_planned": [
    $(IFS=","; for a in "${fixes_planned[@]}"; do printf '"%s",' "$a"; done | sed 's/,$//')
  ],
  "recommended_command": "$rec_cmd"
}
EOF
    return $exit_code
  fi

  # Execution / Fix Mode
  if [ "$do_fix" -eq 1 ] && [ "${#fixes_planned[@]}" -gt 0 ]; then
    if [ "$dry_run" -eq 1 ]; then
      echo -e "\n\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m"
      echo -e " ${C_BOLD}${C_BLUE}UCA DOCTOR (DRY RUN PLAN)${C_RESET} — ${#fixes_planned[@]} actions planned"
      echo -e "\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m\n"
      for act in "${fixes_planned[@]}"; do
        echo -e "  ${C_BLUE}•${C_RESET} $act"
      done
      echo -e "\n${C_GRAY}Run 'uca doctor --fix' to apply these repairs safely with automated backups.${C_RESET}\n"
      return 0
    fi

    run_dir=$(doctor_init_run)
    ln -sfn "$run_dir" "$DOCTOR_DIR/latest" 2>/dev/null || true

    echo -e "\n\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m"
    echo -e " ${C_BOLD}${C_BLUE}UCA DOCTOR AUTO-REPAIR${C_RESET} — Applying ${#fixes_planned[@]} repairs"
    echo -e " ${C_GRAY}Run ID:${C_RESET} $(basename "$run_dir") (Backups in $(basename "$run_dir")/backups/)"
    echo -e "\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m\n"

    # Fix 1: Stale Lock
    if [ "$stale_lock" -eq 1 ]; then
      doctor_mutate "$run_dir" "$LOCK_DIR/pid" "delete_file"
      rm -rf "$LOCK_DIR" 2>/dev/null || true
      echo -e "  ${C_GREEN}✔${C_RESET} [FIX-LOCK-STALE] Reclaimed stale lock directory"
      fixes_applied+=("FIX-LOCK-STALE")
    fi

    # Fix 2: Inactive Service
    if [ "$srv_inactive" -eq 1 ]; then
      install_service
      echo -e "  ${C_GREEN}✔${C_RESET} [FIX-SERVICE-INACTIVE] Re-registered background service"
      fixes_applied+=("FIX-SERVICE-INACTIVE")
    fi

    # Fix 3: Broken Symlink
    if [ "$symlink_broken" -eq 1 ]; then
      doctor_mutate "$run_dir" "$HOME/.local/bin/ucas" "symlink" "$HOME/.local/bin/uca"
      echo -e "  ${C_GREEN}✔${C_RESET} [FIX-SYMLINK-BROKEN] Restored ~/.local/bin/ucas symlink"
      fixes_applied+=("FIX-SYMLINK-BROKEN")
    fi

    # Fix 4: Corrupted State
    if [ "$state_corrupted" -eq 1 ]; then
      local init_state='{"version":1,"last_run_at":null,"last_run_duration_secs":0,"last_run_status":"repaired","most_recently_updated":null,"harnesses":{}}'
      doctor_mutate "$run_dir" "$STATE_FILE" "write_file" "$init_state"
      echo -e "  ${C_GREEN}✔${C_RESET} [FIX-STATE-CORRUPTED] Initialized clean state.json with backup"
      fixes_applied+=("FIX-STATE-CORRUPTED")
    fi

    # Fix 5: Broken Harnesses
    for h in "${broken_harnesses[@]}"; do
      echo -e "  ${C_BLUE}⟳${C_RESET} [FIX-HARNESS-SMOKE] Re-updating $h..."
      update_harness "$h" >/dev/null 2>&1 || true
      if smoke_test_harness "$h"; then
        echo -e "  ${C_GREEN}✔${C_RESET} [FIX-HARNESS-SMOKE] $h successfully verified"
        fixes_applied+=("FIX-HARNESS-SMOKE-$h")
      fi
    done

    # Fix 6: Path Environment
    if [ "$path_env_missing" -eq 1 ]; then
      for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do
        if [ -f "$rc" ] && [ -w "$rc" ]; then
          if ! grep -q 'export PATH=.*\.local/bin' "$rc" 2>/dev/null; then
            doctor_mutate "$run_dir" "$rc" "append_line" "export PATH=\"\$HOME/.local/bin:\$PATH\""
            echo -e "  ${C_GREEN}✔${C_RESET} [FIX-PATH-ENV] Added ~/.local/bin to $rc with backup"
            fixes_applied+=("FIX-PATH-ENV")
            break
          fi
        fi
      done
    fi

    # Fix 7: Alias Conflict
    if [ "$alias_conflict" -eq 1 ]; then
      for rc in "$HOME/.zshrc" "$HOME/.zshrc.local" "$HOME/.bashrc" "$HOME/.bash_aliases"; do
        if [ -f "$rc" ] && [ -w "$rc" ]; then
          if grep -q "^[[:space:]]*alias uca=" "$rc" 2>/dev/null; then
            local cleaned_content
            cleaned_content=$(sed '/^[[:space:]]*alias uca=/d' "$rc")
            doctor_mutate "$run_dir" "$rc" "write_file" "$cleaned_content"
            echo -e "  ${C_GREEN}✔${C_RESET} [FIX-ALIAS-CONFLICT] Removed alias uca from $rc with backup"
            fixes_applied+=("FIX-ALIAS-CONFLICT-$rc")
          fi
        fi
      done
      for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do
        if [ -f "$rc" ] && [ -w "$rc" ] && ! grep -q "unalias uca" "$rc" 2>/dev/null; then
          doctor_mutate "$run_dir" "$rc" "append_line" "unalias uca 2>/dev/null || true"
          echo -e "  ${C_GREEN}✔${C_RESET} [FIX-ALIAS-CONFLICT] Added unalias uca guard to $rc"
        fi
      done
    fi

    echo -e "\n${C_GREEN}${C_BOLD}✔ Auto-repair complete (${#fixes_applied[@]} fixes applied).${C_RESET}"
    echo -e "${C_GRAY}To revert this repair run: uca doctor undo $(basename "$run_dir")${C_RESET}\n"
    return 0
  fi

  # Interactive / Read-Only Diagnostics Display
  echo -e "\n\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m"
  echo -e " ${C_BOLD}${C_BLUE}UCA DOCTOR${C_RESET} — Harness & Environment Diagnostics"
  echo -e "\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m\n"

  echo -e "  ${C_GREEN}✔${C_RESET} Shell runtime: ${C_BOLD}Bash $BASH_VERSION${C_RESET} ($SHELL)"

  if command -v gum &>/dev/null; then
    local gv
    gv=$(gum --version 2>/dev/null || echo "installed")
    echo -e "  ${C_GREEN}✔${C_RESET} Charmbracelet Gum: ${C_GREEN}Found${C_RESET} ($gv)"
  else
    echo -e "  ${C_GRAY}•${C_RESET} Charmbracelet Gum: ${C_GRAY}Not in PATH (ANSI fallback active)${C_RESET}"
  fi

  mkdir -p "$STATE_DIR" 2>/dev/null || true
  if [ -w "$STATE_DIR" ]; then
    echo -e "  ${C_GREEN}✔${C_RESET} State storage: $STATE_DIR (writable=true)"
  else
    echo -e "  ${C_RED}✗${C_RESET} State storage: $STATE_DIR (not writable)"
  fi

  if [ "$free_mb" -lt 50 ]; then
    echo -e "  ${C_RED}✗${C_RESET} Disk Space Safety: ${C_BOLD}${C_RED}${free_mb} MB free${C_RESET} on $HOME (CRITICAL - Minimum required: ${MIN_FREE_DISK_MB} MB)"
  elif [ "$low_disk" -eq 1 ]; then
    echo -e "  ${C_YELLOW}⚠️${C_RESET} Disk Space Safety: ${C_BOLD}${C_YELLOW}${free_mb} MB free${C_RESET} on $HOME (Warning - Below threshold of ${MIN_FREE_DISK_MB} MB)"
  else
    echo -e "  ${C_GREEN}✔${C_RESET} Disk Space Safety: ${C_BOLD}${C_GREEN}${free_gb} GB free${C_RESET} on $HOME (Min safety threshold: ${MIN_FREE_DISK_MB} MB)"
  fi

  if [ "$srv_st" = "ACTIVE" ]; then
    echo -e "  ${C_GREEN}✔${C_RESET} 3-Hour Auto-Updater: ${C_BOLD}${C_GREEN}${srv_msg}${C_RESET}"
  else
    echo -e "  ${C_YELLOW}⚠️${C_RESET} 3-Hour Auto-Updater: ${C_YELLOW}${srv_msg}${C_RESET} (run 'uca doctor --fix' to enable)"
  fi

  echo -e "\n  ${C_BOLD}Harness Integrity & Smoke Checks:${C_RESET}"
  check_harness_doc() {
    local name="$1" key="$2" bin_cand="$3"
    local bin_path=""
    if command -v "$bin_cand" &>/dev/null; then
      bin_path=$(command -v "$bin_cand")
    elif [ -x "$HOME/.local/bin/$bin_cand" ]; then
      bin_path="$HOME/.local/bin/$bin_cand"
    elif [ -x "$HOME/.bun/bin/$bin_cand" ]; then
      bin_path="$HOME/.bun/bin/$bin_cand"
    elif [ -x "$HOME/.grok/bin/$bin_cand" ]; then
      bin_path="$HOME/.grok/bin/$bin_cand"
    fi

    if [ -n "$bin_path" ]; then
      local v smoke_st
      v=$(get_harness_version "$key")
      [ -z "$v" ] && v="unknown"
      if smoke_test_harness "$key"; then
        smoke_st="${C_GREEN}Ready${C_RESET}"
      else
        smoke_st="${C_YELLOW}Warning${C_RESET}"
      fi
      local p_name p_bin p_ver
      p_name=$(pad_str "$name" 20)
      p_bin=$(pad_str "$bin_path" 38)
      p_ver=$(pad_str "$v" 14)
      echo -e "    ${C_GREEN}✔${C_RESET} ${p_name} ${C_GRAY}${p_bin}${C_RESET} Version: ${C_BOLD}${p_ver}${C_RESET} Smoke: $smoke_st"
    else
      echo -e "    ${C_GRAY}•${C_RESET} $(pad_str "$name" 20) ${C_GRAY}Binary not installed${C_RESET}"
    fi
  }

  check_harness_doc "Claude Code"        "claude" "claude"
  check_harness_doc "OpenAI Codex"       "codex"  "codex"
  check_harness_doc "Google Antigravity"  "agy"    "agy"
  check_harness_doc "xAI Grok"           "grok"   "grok"
  check_harness_doc "OMP"                "omp"    "omp"

  if [ "${#findings[@]}" -gt 0 ]; then
    echo -e "\n  ${C_YELLOW}⚠️  ${#findings[@]} issues detected. Run '${C_BOLD}uca doctor --fix${C_RESET}' to auto-remediate.${C_RESET}"
    echo -e "\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m\n"
    return 1
  fi

  echo -e "\n\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m\n"
  return 0
}

# Background Service Installer
install_service() {
  echo -e "\n${C_BOLD}${C_BLUE}Configuring UCA 3-hour background scheduler...${C_RESET}"
  if [ "$(uname -s)" = "Darwin" ] && command -v launchctl &>/dev/null; then
    mkdir -p "$LAUNCHD_DIR"
    local current_user="${USER:-$(whoami 2>/dev/null || echo "user")}"
    local plist_label="com.${current_user}.uca"
    local plist_path="$LAUNCHD_DIR/${plist_label}.plist"
    local path_env="$HOME/.local/bin:$HOME/.bun/bin:$HOME/.grok/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

    cat > "$plist_path" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${plist_label}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${HOME}/.local/bin/uca</string>
        <string>--quiet</string>
        <string>--notify</string>
    </array>
    <key>StartInterval</key>
    <integer>10800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${STATE_DIR}/uca.log</string>
    <key>StandardErrorPath</key>
    <string>${STATE_DIR}/uca-error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>${path_env}</string>
        <key>HOME</key>
        <string>${HOME}</string>
    </dict>
</dict>
</plist>
EOF
    launchctl unload "$plist_path" 2>/dev/null || true
    launchctl load -w "$plist_path" 2>/dev/null || true
    echo -e "  ${C_GREEN}✔${C_RESET} Registered launchd agent ${C_BOLD}${plist_label}${C_RESET} (every 3 hours)"
  elif command -v systemctl &>/dev/null; then
    mkdir -p "$SYSTEMD_USER_DIR"
    local service_file="$SYSTEMD_USER_DIR/uca.service"
    local timer_file="$SYSTEMD_USER_DIR/uca.timer"

    cat > "$service_file" <<EOF
[Unit]
Description=Universal Coding Agent Harness Auto-Updater (UCA)
After=network-online.target default.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=$HOME/.local/bin/uca --quiet --notify
TimeoutStartSec=600
Restart=no
StandardOutput=journal
StandardError=journal
Environment=HOME=$HOME
Environment=PATH=$HOME/.local/bin:$HOME/.bun/bin:$HOME/.grok/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EOF

    cat > "$timer_file" <<EOF
[Unit]
Description=Universal Coding Agent Harness Auto-Updater Timer (every 3 hours)

[Timer]
OnCalendar=*-*-* 00,03,06,09,12,15,18,21:00:00
OnBootSec=5min
Persistent=true
RandomizedDelaySec=180

[Install]
WantedBy=timers.target
EOF
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user enable --now uca.timer 2>/dev/null || true
    echo -e "  ${C_GREEN}✔${C_RESET} Enabled systemd user timer ${C_BOLD}uca.timer${C_RESET} (every 3 hours)"
  fi
}

# Uninstaller
run_uninstaller() {
  local purge="${1:-0}" force="${2:-0}"
  echo -e "\n\033[38;5;214m════════════════════════════════════════════════════════════════════════════\033[0m"
  echo -e " ${C_BOLD}${C_YELLOW}UCA UNINSTALLER${C_RESET} — Clean Removal Wizard"
  echo -e "\033[38;5;214m════════════════════════════════════════════════════════════════════════════\033[0m\n"

  if [ "$force" -eq 0 ]; then
    if has_gum; then
      if ! gum confirm "Are you sure you want to completely uninstall UCA and its background services?"; then
        echo -e "${C_GRAY}Uninstallation aborted.${C_RESET}"
        return 0
      fi
    else
      echo -ne "\033[38;5;214mAre you sure you want to completely uninstall UCA and its background services? [y/N]: \033[0m"
      read -r ans
      case "$ans" in
        y|Y|yes|Yes|YES) ;;
        *) echo -e "${C_GRAY}Uninstallation aborted.${C_RESET}"; return 0 ;;
      esac
    fi
  fi

  # Stop launchd
  if [ "$(uname -s)" = "Darwin" ] && command -v launchctl &>/dev/null; then
    local current_user="${USER:-$(whoami 2>/dev/null || echo "user")}"
    for plist_name in "com.${current_user}.uca.plist" "com.uca.updater.plist"; do
      local plist_file="$LAUNCHD_DIR/$plist_name"
      if [ -f "$plist_file" ]; then
        launchctl unload "$plist_file" 2>/dev/null || true
        rm -f "$plist_file" 2>/dev/null || true
        echo -e "  ${C_GREEN}✔${C_RESET} Removed launchd agent ($plist_name)"
      fi
    done
  fi

  # Stop systemd
  if command -v systemctl &>/dev/null; then
    systemctl --user disable --now uca.timer 2>/dev/null || true
    systemctl --user stop uca.service 2>/dev/null || true
    rm -f "$SYSTEMD_USER_DIR/uca.service" "$SYSTEMD_USER_DIR/uca.timer" 2>/dev/null || true
    systemctl --user daemon-reload 2>/dev/null || true
    echo -e "  ${C_GREEN}✔${C_RESET} Removed systemd units"
  fi

  # Clean aliases
  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.config/fish/config.fish"; do
    if [ -f "$rc" ] && grep -q "alias ucas=" "$rc" 2>/dev/null; then
      sed -i.bak '/alias ucas=/d; /alias uca=/d' "$rc" 2>/dev/null || true
      rm -f "${rc}.bak" 2>/dev/null || true
      echo -e "  ${C_GREEN}✔${C_RESET} Removed aliases from $rc"
    fi
  done

  # Purge state directory if requested
  if [ "$purge" -eq 1 ] && [ -d "$STATE_DIR" ]; then
    rm -rf "$STATE_DIR" 2>/dev/null || true
    echo -e "  ${C_GREEN}✔${C_RESET} Purged state directory ($STATE_DIR)"
  fi

  # Remove binaries
  for b in "$HOME/.local/bin/uca" "$HOME/.local/bin/ucas" "/usr/local/bin/uca" "/usr/local/bin/ucas"; do
    if [ -f "$b" ] || [ -L "$b" ]; then
      rm -f "$b" 2>/dev/null || true
      echo -e "  ${C_GREEN}✔${C_RESET} Removed $b"
    fi
  done

  echo -e "\n${C_GREEN}${C_BOLD}✔ UCA has been cleanly uninstalled.${C_RESET}\n"
}

# Main CLI Router
main() {
  local prog_name
  prog_name=$(basename "$0")
  
  # Invocation as ucas or uca status
  if [ "$prog_name" = "ucas" ] || { [ $# -gt 0 ] && [[ "$1" =~ ^(status|s|st|-s|--status)$ ]]; }; then
    shift 2>/dev/null || true
    local json_m=0
    for a in "$@"; do
      case "$a" in
        --json) json_m=1 ;;
        --no-gum) NO_GUM=1 ;;
        -w|--watch)
          local int=5
          shift 2>/dev/null || true
          [ -n "${1:-}" ] && [[ "$1" =~ ^[0-9]+$ ]] && int="$1"
          run_watch_mode "$int"
          return 0
          ;;
        -h|--help)
          echo "Usage: ucas [OPTIONS]"
          echo ""
          echo "Options:"
          echo "  -w, --watch [SEC]  Interactive auto-refreshing live dashboard (default: 5s)"
          echo "  -f, --fast         Probe versions in parallel (ultra-fast sub-second refresh)"
          echo "  --json             Output status in JSON format"
          echo "  --no-gum           Disable gum styling and use ANSI fallback"
          echo "  -h, --help         Show this help message"
          return 0
          ;;
      esac
    done
    show_status_dashboard "$json_m"
    return 0
  fi

  # Doctor Subcommand Dispatcher
  if [ $# -gt 0 ] && [[ "$1" =~ ^(doctor|doc|--doctor)$ ]]; then
    shift
    local doc_fix=0 doc_dry=0 doc_json=0 doc_triage=0 doc_health=0

    while [ $# -gt 0 ]; do
      case "$1" in
        --fix)          doc_fix=1 ;;
        --dry-run)      doc_dry=1 ;;
        --json|--robot) doc_json=1 ;;
        --robot-triage) doc_triage=1 ;;
        health)         doc_health=1 ;;
        capabilities)   doctor_capabilities; return 0 ;;
        robot-docs)     doctor_robot_docs; return 0 ;;
        undo)
          shift
          doctor_undo "${1:-latest}"
          return $?
          ;;
        -h|--help)
          echo "Usage: uca doctor [OPTIONS]"
          echo ""
          echo "Commands:"
          echo "  uca doctor               Read-only diagnostics (exit 0 healthy, 1 findings)"
          echo "  uca doctor --fix         Safe auto-repair with automated backups"
          echo "  uca doctor undo [RUN_ID] Revert changes made by doctor --fix"
          echo "  uca doctor health        Fast one-line health summary for CI/scripts"
          echo "  uca doctor capabilities  Machine-readable JSON schema of detectors & fixers"
          echo "  uca doctor robot-docs    Paste-ready handbook for AI agent callers"
          echo "  uca doctor --robot-triage Single-call JSON mega-command"
          return 0
          ;;
      esac
      shift 2>/dev/null || break
    done

    run_doctor_suite "$doc_fix" "$doc_dry" "$doc_json" "$doc_triage" "$doc_health"
    return $?
  fi

  # Subcommands
  if [ $# -gt 0 ]; then
    case "$1" in
      logs|log|--logs)
        shift
        local err_m=0 fol_m=0
        for a in "$@"; do
          [ "$a" = "-e" ] || [ "$a" = "--errors" ] && err_m=1
          [ "$a" = "-f" ] || [ "$a" = "--follow" ] && fol_m=1
        done
        view_logs "$err_m" "$fol_m"
        return 0
        ;;
      uninstall|--uninstall|remove)
        shift
        local p_purge=0 p_force=0
        for a in "$@"; do
          [ "$a" = "--purge" ] && p_purge=1
          [ "$a" = "-y" ] || [ "$a" = "--yes" ] && p_force=1
        done
        run_uninstaller "$p_purge" "$p_force"
        return 0
        ;;
      service|--service)
        shift
        local action="${1:-install}"
        if [ "$action" = "install" ] || [ "$action" = "enable" ]; then
          install_service
        else
          get_service_status
        fi
        return 0
        ;;
      check|--check)
        show_status_dashboard 0
        return 0
        ;;
      -h|--help|help)
        echo "UCA — Universal Coding Agent Harness Updater & Version Tracker"
        echo ""
        echo "Usage:"
        echo "  uca                 Update all agent harnesses (claude, codex, agy, grok, omp)"
        echo "  ucas                Show status breakdown, version changes, and schedule"
        echo "  ucas -w, --watch    Interactive live auto-refreshing dashboard"
        echo "  uca <harness>       Update specific harness (e.g. 'uca omp', 'uca claude')"
        echo "  uca doctor          Run preflight diagnostics & self-test"
        echo "  uca doctor --fix    Safely repair detected issues with automated backups"
        echo "  uca doctor undo     Revert changes from latest doctor run"
        echo "  uca logs            Inspect update logs (--errors, --follow)"
        echo "  uca service install Install 3-hour background auto-updater service"
        echo "  uca service status  Show background service status"
        echo "  uca uninstall       Cleanly remove UCA, timers, and aliases (--purge)"
        echo "  uca check           Probe versions without running updates"
        echo ""
        echo "Options:"
        echo "  -q, --quiet            Minimal output (for automated / cron / service runs)"
        echo "  --notify               Dispatch desktop notification on version change"
        echo "  --no-smoke-test        Skip post-update verification guard"
        echo "  --ignore-disk-space    Bypass free disk space safety threshold"
        echo "  --min-disk-mb <N>      Set minimum free disk space threshold (default: 500 MB)"
        echo "  --dry-run              Check versions without applying updates"
        echo "  --no-gum               Disable gum styling and use ANSI fallback"
        echo "  --json                 Output status in JSON format"
        echo "  -h, --help             Show this help message"
        return 0
        ;;
    esac
  fi

  # Flags parsing for update run
  local q_flag=0 dry_flag=0 notif_flag=0 smoke_flag=1 ign_disk=0 min_d="$MIN_FREE_DISK_MB" target=""

  while [ $# -gt 0 ]; do
    case "$1" in
      -q|--quiet)          q_flag=1; notif_flag=1 ;;
      --dry-run)           dry_flag=1 ;;
      --notify)            notif_flag=1 ;;
      --no-smoke-test)     smoke_flag=0 ;;
      --no-gum)            NO_GUM=1 ;;
      --ignore-disk-space) ign_disk=1 ;;
      --min-disk-mb=*)     min_d="${1#*=}" ;;
      --min-disk-mb)       shift; min_d="$1" ;;
      claude|codex|agy|grok|omp) target="$1" ;;
      all) target="" ;;
    esac
    shift 2>/dev/null || break
  done

  run_all_updates "$target" "$q_flag" "$dry_flag" "$notif_flag" "$smoke_flag" "$ign_disk" "$min_d"
}

main "$@"
