# Service Detection
get_service_status() {
  if command -v launchctl &>/dev/null && [ "$(uname -s)" = "Darwin" ]; then
    local current_user="${USER:-$(whoami 2>/dev/null || echo "user")}"
    local loaded=0
    for lbl in "com.${current_user}.uca" "com.jemanuel.uca" "com.uca.updater"; do
      if launchctl list 2>/dev/null | grep -q "$lbl"; then
        loaded=1
        break
      fi
    done
    if [ "$loaded" -eq 1 ]; then
      echo "ACTIVE|launchd background service active (every 3 hours / 10800s)"
    else
      echo "INACTIVE|launchd agent installed but not loaded"
    fi
  elif command -v systemctl &>/dev/null; then
    if systemctl --user is-active uca.timer &>/dev/null; then
      echo "ACTIVE|systemd timer active (every 3h)"
    else
      echo "INACTIVE|systemd timer not active"
    fi
  else
    echo "INACTIVE|No systemd or launchd scheduler detected"
  fi
}

# Relative Time Formatter
format_relative_time() {
  local iso_str="$1"
  [ -z "$iso_str" ] && { echo "Never"; return; }
  
  local ts_now ts_past diff mins hours days
  ts_now=$(date +%s)
  if [ "$(uname -s)" = "Darwin" ]; then
    ts_past=$(date -j -f "%Y-%m-%dT%H:%M:%S" "${iso_str:0:19}" +%s 2>/dev/null || echo "$ts_now")
  else
    ts_past=$(date -d "$iso_str" +%s 2>/dev/null || echo "$ts_now")
  fi
  
  diff=$((ts_now - ts_past))
  [ "$diff" -lt 0 ] && diff=0
  
  if [ "$diff" -lt 60 ]; then
    echo "${diff}s ago"
  elif [ "$diff" -lt 3600 ]; then
    mins=$((diff / 60))
    echo "${mins}m ago"
  elif [ "$diff" -lt 86400 ]; then
    hours=$((diff / 3600))
    echo "${hours}h ago"
  else
    days=$((diff / 86400))
    echo "${days}d ago"
  fi
}

# Status Dashboard (UCAS)
show_status_dashboard() {
  local json_mode="${1:-0}"
  
  # Parallel Fast Probing using subshells
  V_CLAUDE="" V_CODEX="" V_AGY="" V_GROK="" V_OMP=""
  
  local tmp_dir="$STATE_DIR/.probe.$$"
  mkdir -p "$tmp_dir"
  
  ( get_harness_version "claude" > "$tmp_dir/claude" ) &
  ( get_harness_version "codex"  > "$tmp_dir/codex" ) &
  ( get_harness_version "agy"    > "$tmp_dir/agy" ) &
  ( get_harness_version "grok"   > "$tmp_dir/grok" ) &
  ( get_harness_version "omp"    > "$tmp_dir/omp" ) &
  wait

  [ -f "$tmp_dir/claude" ] && V_CLAUDE=$(cat "$tmp_dir/claude")
  [ -f "$tmp_dir/codex" ]  && V_CODEX=$(cat "$tmp_dir/codex")
  [ -f "$tmp_dir/agy" ]    && V_AGY=$(cat "$tmp_dir/agy")
  [ -f "$tmp_dir/grok" ]   && V_GROK=$(cat "$tmp_dir/grok")
  [ -f "$tmp_dir/omp" ]    && V_OMP=$(cat "$tmp_dir/omp")
  rm -rf "$tmp_dir" 2>/dev/null || true

  # Disk Space
  local free_mb free_gb
  free_mb=$(get_free_disk_mb "$HOME")
  free_gb=$(awk "BEGIN {printf \"%.1f\", $free_mb / 1024}")
  local is_low_disk=0
  [ "$free_mb" -lt "$MIN_FREE_DISK_MB" ] && is_low_disk=1

  # State reading
  local last_run_at last_status mru_key mru_from mru_to mru_ts
  last_run_at=$(read_state_field '"last_run_at"')
  last_status=$(read_state_field '"last_run_status"')
  mru_key=$(read_state_field '"key"')
  mru_from=$(read_state_field '"from_version"')
  mru_to=$(read_state_field '"to_version"')
  mru_ts=$(read_state_field '"timestamp"')

  local last_run_rel
  last_run_rel=$(format_relative_time "$last_run_at")

  # Service status
  local srv_info srv_state srv_detail
  srv_info=$(get_service_status)
  srv_state="${srv_info%%|*}"
  srv_detail="${srv_info##*|}"

  if [ "$json_mode" -eq 1 ]; then
    if [ -f "$STATE_FILE" ]; then
      cat "$STATE_FILE"
    else
      echo '{"error": "No state file found"}'
    fi
    return 0
  fi

  local use_gum=0
  has_gum && use_gum=1

  if [ "$use_gum" -eq 1 ]; then
    local srv_badge disk_badge
    if [ "$srv_state" = "ACTIVE" ]; then
      srv_badge=$(gum style --foreground 42 --bold "ACTIVE")
    else
      srv_badge=$(gum style --foreground 214 --bold "INACTIVE")
    fi

    if [ "$is_low_disk" -eq 1 ]; then
      disk_badge=$(gum style --foreground 196 --bold "⚠️ ${free_mb} MB (PAUSED)")
    else
      disk_badge="$(gum style --foreground 42 --bold "${free_gb} GB free") $(gum style --foreground 245 '(healthy)')"
    fi

    gum style \
      --border rounded \
      --border-foreground 39 \
      --padding "0 1" \
      --margin "1 0 0 0" \
      "$(gum style --foreground 42 --bold 'UCA STATUS') $(gum style --foreground 245 '— Universal Coding Agent Harness Dashboard')" \
      "$(gum style --foreground 245 'Last Full Run:') $(gum style --bold --foreground 252 "$last_run_rel")" \
      "$(gum style --foreground 245 'Background Service:') $srv_badge $(gum style --foreground 245 "• $srv_detail")" \
      "$(gum style --foreground 245 'Disk Safety:') $disk_badge $(gum style --foreground 245 "• Threshold: ${MIN_FREE_DISK_MB} MB")"

    if [ -n "$mru_key" ] && [ -n "$mru_from" ] && [ -n "$mru_to" ] && [ "$mru_from" != "$mru_to" ]; then
      local mru_rel
      mru_rel=$(format_relative_time "$mru_ts")
      local mru_title mru_body
      mru_title=$(gum style --foreground 214 --bold "⭐ MOST RECENTLY UPDATED HARNESS")
      mru_body="$(gum style --foreground 42 --bold "$mru_key") $(gum style --foreground 245 '• From version') $(gum style --foreground 214 --bold "$mru_from") $(gum style --foreground 245 'to version') $(gum style --foreground 42 --bold "$mru_to") $(gum style --foreground 245 "($mru_rel)")"
      gum style \
        --border normal \
        --border-foreground 214 \
        --padding "0 1" \
        --margin "1 0 0 0" \
        "$mru_title" \
        "$mru_body"
    fi
  else
    local term_width=116
    local sep=""
    for ((i=0; i<term_width; i++)); do sep="${sep}═"; done

    echo -e "\n\033[38;5;39m${sep}\033[0m"
    echo -e " ${C_BOLD}${C_BLUE}UCA STATUS${C_RESET} — Universal Coding Agent Harness Dashboard"
    echo -e " ${C_GRAY}Last Full Run:${C_RESET} ${C_BOLD}${last_run_rel}${C_RESET}"
    
    if [ "$srv_state" = "ACTIVE" ]; then
      echo -e " ${C_GRAY}Background Service:${C_RESET} ${C_GREEN}${C_BOLD}ACTIVE${C_RESET} • ${C_GRAY}${srv_detail}${C_RESET}"
    else
      echo -e " ${C_GRAY}Background Service:${C_RESET} ${C_YELLOW}INACTIVE / MANUAL${C_RESET} • ${C_GRAY}${srv_detail}${C_RESET}"
    fi

    if [ "$is_low_disk" -eq 1 ]; then
      echo -e " ${C_RED}${C_BOLD}Disk Safety:${C_RESET} ${C_RED}${C_BOLD}⚠️ ${free_mb} MB free${C_RESET} • ${C_YELLOW}CRITICAL (Below ${MIN_FREE_DISK_MB} MB threshold) • Auto-updates paused${C_RESET}"
    else
      echo -e " ${C_GRAY}Disk Safety:${C_RESET} ${C_GREEN}${C_BOLD}${free_gb} GB free${C_RESET} ${C_GRAY}(healthy) • Threshold: ${MIN_FREE_DISK_MB} MB${C_RESET}"
    fi
    echo -e "\033[38;5;39m${sep}\033[0m\n"

    if [ -n "$mru_key" ] && [ -n "$mru_from" ] && [ -n "$mru_to" ] && [ "$mru_from" != "$mru_to" ]; then
      local mru_rel
      mru_rel=$(format_relative_time "$mru_ts")
      echo -e " ${C_YELLOW}${C_BOLD}⭐ MOST RECENTLY UPDATED HARNESS:${C_RESET}"
      echo -e "    ${C_BOLD}${C_GREEN}${mru_key}${C_RESET}  ${C_GRAY}•${C_RESET}  From version ${C_YELLOW}${mru_from}${C_RESET} to version ${C_BOLD}${C_GREEN}${mru_to}${C_RESET}  ${C_GRAY}(${mru_rel})${C_RESET}\n"
    fi
  fi

  # Table
  local subsep=""
  for ((i=0; i<116; i++)); do subsep="${subsep}─"; done

  echo -e "\n ${C_BOLD}HARNESS BREAKDOWN${C_RESET}"
  echo -e "${C_GRAY}${subsep}${C_RESET}"

  local h_harness h_ver h_status h_change h_checked
  h_harness=$(pad_str "Harness" 22)
  h_ver=$(pad_str "Version" 12)
  h_status=$(pad_str "Status" 16)
  h_change=$(pad_str "Version Changes" 52)
  h_checked=$(pad_str "Checked" 12)

  echo -e " ${C_BOLD}${C_BLUE}${h_harness}${h_ver}${h_status}${h_change}${h_checked}${C_RESET}"
  echo -e "${C_GRAY}${subsep}${C_RESET}"

  render_harness_row() {
    local name="$1" key="$2" ver="$3"
    local prev_ver status_badge change_text
    prev_ver=$(read_harness_prev_version_from_state "$key")

    if [ -z "$ver" ]; then
      echo -e " $(pad_str "$name" 22)$(pad_str "-" 12)$(pad_str "${C_GRAY}Not Found${C_RESET}" 16)$(pad_str "${C_GRAY}Binary not installed in PATH${C_RESET}" 52)$(pad_str "-" 12)"
    else
      local v_badge="${C_BOLD}${C_WHITE}${ver}${C_RESET}"
      local s_badge="${C_GREEN}✔ Up to date${C_RESET}"
      local c_txt="Up to date at ${ver}"
      
      if [ -n "$prev_ver" ] && [ "$prev_ver" != "$ver" ]; then
        s_badge="${C_GREEN}${C_BOLD}✔ Updated${C_RESET}"
        c_txt="From version ${C_YELLOW}${prev_ver}${C_RESET} to version ${C_BOLD}${C_GREEN}${ver}${C_RESET} ${C_GRAY}(${last_run_rel})${C_RESET}"
      fi

      echo -e " $(pad_str "$name" 22)$(pad_str "$v_badge" 12)$(pad_str "$s_badge" 16)$(pad_str "$c_txt" 52)$(pad_str "$last_run_rel" 12)"
    fi
  }

  render_harness_row "Claude Code"       "claude" "$V_CLAUDE"
  render_harness_row "OpenAI Codex"      "codex"  "$V_CODEX"
  render_harness_row "Google Antigravity" "agy"    "$V_AGY"
  render_harness_row "xAI Grok"          "grok"   "$V_GROK"
  render_harness_row "OMP"               "omp"    "$V_OMP"

  echo -e "${C_GRAY}${subsep}${C_RESET}\n"

  if [ -n "$mru_key" ] && [ -n "$mru_from" ] && [ -n "$mru_to" ] && [ "$mru_from" != "$mru_to" ]; then
    echo -e " ${C_BOLD}📜 RECENT VERSION CHANGE HISTORY${C_RESET}"
    echo -e "${C_GRAY}${subsep}${C_RESET}"
    local time_fmt="${mru_ts:0:10} ${mru_ts:11:5}"
    echo -e "  ${C_BLUE}•${C_RESET} ${C_GRAY}${time_fmt}${C_RESET}  ${C_BOLD}$(pad_str "$mru_key" 18)${C_RESET} From version ${C_YELLOW}${mru_from}${C_RESET} to version ${C_BOLD}${C_GREEN}${mru_to}${C_RESET}"
    echo -e "${C_GRAY}${subsep}${C_RESET}\n"
  fi

  echo -e " ${C_GRAY}Commands:${C_RESET} ${C_BOLD}uca${C_RESET} (update all) • ${C_BOLD}ucas${C_RESET} (status) • ${C_BOLD}ucas -w${C_RESET} (watch) • ${C_BOLD}uca doctor${C_RESET} • ${C_BOLD}uca logs${C_RESET} • ${C_BOLD}uca uninstall${C_RESET}"
  echo -e "\033[38;5;39m${subsep}\033[0m\n"
}

# Run Updates
run_all_updates() {
  local target_key="${1:-}"
  local quiet="${2:-0}"
  local dry_run="${3:-0}"
  local notify="${4:-1}"
  local smoke_test="${5:-1}"
  local ignore_disk="${6:-0}"
  local min_disk="${7:-$MIN_FREE_DISK_MB}"

  acquire_lock

  local now_iso start_sec
  now_iso=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date +"%Y-%m-%dT%H:%M:%SZ")
  start_sec=$(date +%s)

  # 1. Disk Space Safety Guard
  local free_mb
  free_mb=$(get_free_disk_mb "$HOME")
  if [ "$free_mb" -lt "$min_disk" ] && [ "$ignore_disk" -eq 0 ] && [ "$dry_run" -eq 0 ]; then
    if [ "$quiet" -eq 0 ]; then
      if has_gum; then
        gum style \
          --border double \
          --border-foreground 196 \
          --padding "0 2" \
          --margin "1 0" \
          "$(gum style --foreground 196 --bold '⚠️  DISK SPACE SAFETY GUARD TRIGGERED')" \
          "" \
          "$(gum style --foreground 252 --bold "Available space: ${free_mb} MB") $(gum style --foreground 245 "(Minimum required: ${min_disk} MB)")" \
          "$(gum style --foreground 245 'All update attempts skipped to prevent corrupted downloads or broken installs.')" \
          "$(gum style --foreground 245 'To override: uca --ignore-disk-space or set UCA_MIN_DISK_MB=0')"
      else
        local warn_lines=(
          "\033[1;38;5;196m⚠️  DISK SPACE SAFETY GUARD TRIGGERED\033[0m"
          ""
          "\033[1;38;5;252mAvailable space: ${free_mb} MB\033[0m \033[38;5;245m(Minimum required: ${min_disk} MB)\033[0m"
          "\033[38;5;245mAll update attempts skipped to prevent corrupted downloads or broken installs.\033[0m"
          "\033[38;5;245mTo override: uca --ignore-disk-space or set UCA_MIN_DISK_MB=0\033[0m"
        )
        draw_box 196 "${warn_lines[@]}"
      fi
    fi

    if [ "$notify" -eq 1 ] && [ "$quiet" -eq 1 ]; then
      send_desktop_notification "⚠️ UCA Auto-Updates Paused" "Low disk space (${free_mb} MB free). Free disk space to resume auto-updates."
    fi

    mkdir -p "$STATE_DIR"
    echo "[$now_iso] uca run SKIPPED: low disk space (${free_mb} MB free)" >> "$LOG_FILE" 2>/dev/null || true
    release_lock
    return 0
  fi

  if [ "$quiet" -eq 0 ]; then
    local start_time_str
    start_time_str=$(date +"%Y-%m-%d %H:%M:%S")
    if has_gum; then
      gum style \
        --border normal \
        --border-foreground 39 \
        --padding "0 1" \
        --margin "1 0" \
        "$(gum style --foreground 42 --bold 'UCA') $(gum style --foreground 245 '— Universal Coding Agent Harness Updater')" \
        "$(gum style --foreground 245 "Started at: $start_time_str")"
    else
      echo -e "\n\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m"
      echo -e " ${C_BOLD}${C_BLUE}UCA${C_RESET} — Universal Coding Agent Harness Updater"
      echo -e " ${C_GRAY}Started at:${C_RESET} $start_time_str"
      echo -e "\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m\n"
    fi
  fi

  # Harness update loop
  local harnesses=("claude" "codex" "agy" "grok" "omp")
  if [ -n "$target_key" ]; then
    harnesses=("$target_key")
  fi

  local any_updated=0 has_errors=0
  local mru_key="" mru_from="" mru_to="" mru_ts=""
  local upgraded_list=()

  # Load previous versions from state
  PV_CLAUDE=$(read_harness_version_from_state "claude")
  PV_CODEX=$(read_harness_version_from_state "codex")
  PV_AGY=$(read_harness_version_from_state "agy")
  PV_GROK=$(read_harness_version_from_state "grok")
  PV_OMP=$(read_harness_version_from_state "omp")

  for h in "${harnesses[@]}"; do
    local h_name=""
    case "$h" in
      claude) h_name="Claude Code" ;;
      codex)  h_name="OpenAI Codex" ;;
      agy)    h_name="Google Antigravity" ;;
      grok)   h_name="xAI Grok" ;;
      omp)    h_name="OMP" ;;
    esac

    local v_before
    v_before=$(get_harness_version "$h")
    if [ -z "$v_before" ]; then
      [ "$quiet" -eq 0 ] && echo -e "  ${C_GRAY}•${C_RESET} $(pad_str "${C_BOLD}${h_name}${C_RESET}" 20) ${C_GRAY}Not installed${C_RESET} (skipped)"
      continue
    fi

    if [ "$dry_run" -eq 1 ]; then
      [ "$quiet" -eq 0 ] && echo -e "  ${C_BLUE}•${C_RESET} $(pad_str "${C_BOLD}${h_name}${C_RESET}" 20) ${C_YELLOW}[DRY-RUN]${C_RESET} Current: $v_before"
      continue
    fi

    [ "$quiet" -eq 0 ] && echo -ne "  ${C_BLUE}⟳${C_RESET} Updating ${C_BOLD}${h_name}${C_RESET}..."

    local h_start h_dur out ret
    h_start=$(date +%s)
    out=$(update_harness "$h" 2>&1)
    ret=$?
    h_dur=$(( $(date +%s) - h_start ))

    local v_after
    v_after=$(get_harness_version "$h")
    [ -z "$v_after" ] && v_after="$v_before"

    local smoke_ok=1
    if [ "$smoke_test" -eq 1 ] && [ "$ret" -eq 0 ]; then
      smoke_test_harness "$h" || smoke_ok=0
    fi

    # Set version globals for state write
    case "$h" in
      claude) V_CLAUDE="$v_after"; ST_CLAUDE="up_to_date" ;;
      codex)  V_CODEX="$v_after";  ST_CODEX="up_to_date" ;;
      agy)    V_AGY="$v_after";    ST_AGY="up_to_date" ;;
      grok)   V_GROK="$v_after";   ST_GROK="up_to_date" ;;
      omp)    V_OMP="$v_after";    ST_OMP="up_to_date" ;;
    esac

    if [ -n "$v_before" ] && [ -n "$v_after" ] && [ "$v_before" != "$v_after" ]; then
      any_updated=1
      mru_key="$h_name"
      mru_from="$v_before"
      mru_to="$v_after"
      mru_ts="$now_iso"
      upgraded_list+=("$h_name")

      case "$h" in
        claude) ST_CLAUDE="updated" ;;
        codex)  ST_CODEX="updated" ;;
        agy)    ST_AGY="updated" ;;
        grok)   ST_GROK="updated" ;;
        omp)    ST_OMP="updated" ;;
      esac

      if [ "$quiet" -eq 0 ]; then
        echo -e "\r  ${C_GREEN}🎉${C_RESET} $(pad_str "${C_BOLD}${h_name}${C_RESET}" 20) ${C_BOLD}${C_GREEN}UPDATED${C_RESET}: From version ${C_YELLOW}${v_before}${C_RESET} to version ${C_BOLD}${C_GREEN}${v_after}${C_RESET} (${h_dur}s)"
      fi
    else
      if [ "$ret" -eq 0 ] && [ "$smoke_ok" -eq 1 ]; then
        if [ "$quiet" -eq 0 ]; then
          echo -e "\r  ${C_GREEN}✔${C_RESET} $(pad_str "${C_BOLD}${h_name}${C_RESET}" 20) ${C_GREEN}Up to date${C_RESET} (${v_after}) (${h_dur}s)"
        fi
      else
        has_errors=1
        case "$h" in
          claude) ST_CLAUDE="error" ;;
          codex)  ST_CODEX="error" ;;
          agy)    ST_AGY="error" ;;
          grok)   ST_GROK="error" ;;
          omp)    ST_OMP="error" ;;
        esac
        if [ "$quiet" -eq 0 ]; then
          echo -e "\r  ${C_YELLOW}⚠️${C_RESET} $(pad_str "${C_BOLD}${h_name}${C_RESET}" 20) ${C_YELLOW}Update Warning${C_RESET} (${v_after})"
        fi
      fi
    fi
  done

  local total_dur=$(( $(date +%s) - start_sec ))
  local run_status="success"
  [ "$any_updated" -eq 1 ] && run_status="updated"
  [ "$has_errors" -eq 1 ] && run_status="error"

  if [ "$dry_run" -eq 0 ]; then
    write_state "$now_iso" "$run_status" "$total_dur" "$mru_key" "$mru_from" "$mru_to" "$mru_ts"
  fi

  # Notifications
  if [ "$notify" -eq 1 ] && [ "$any_updated" -eq 1 ]; then
    if [ "${#upgraded_list[@]}" -eq 1 ]; then
      send_desktop_notification "🚀 ${upgraded_list[0]} Upgraded" "From version $mru_from to $mru_to"
    else
      local joined
      joined=$(IFS=", "; echo "${upgraded_list[*]}")
      send_desktop_notification "🚀 Agent Harnesses Upgraded" "Updated ${#upgraded_list[@]} harnesses: $joined"
    fi
  fi

  if [ "$quiet" -eq 0 ]; then
    if has_gum; then
      local status_txt
      status_txt=$(gum style --foreground 42 --bold 'Completed')
      echo -e "\n$(gum style --foreground 245 "Completed in: ${total_dur}s") • $status_txt"
      if [ -n "$mru_key" ] && [ -n "$mru_from" ] && [ -n "$mru_to" ]; then
        gum style --foreground 39 --bold "Most Recent Update: $mru_key (From version $mru_from to $mru_to)"
      fi
      echo ""
    else
      echo -e "\n${C_GRAY}────────────────────────────────────────────────────────────────────────────${C_RESET}"
      echo -e " ${C_GRAY}Completed in:${C_RESET} ${total_dur}s • Status: ${C_GREEN}Completed${C_RESET}"
      if [ -n "$mru_key" ] && [ -n "$mru_from" ] && [ -n "$mru_to" ]; then
        echo -e " ${C_BOLD}${C_BLUE}Most Recent Update:${C_RESET} $mru_key (From version $mru_from to $mru_to)"
      fi
      echo -e "\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m\n"
    fi
  fi

  # Log write
  mkdir -p "$STATE_DIR"
  echo "[$now_iso] uca run: duration=${total_dur}s, updated=$any_updated, errors=$has_errors" >> "$LOG_FILE" 2>/dev/null || true

  release_lock
  return $has_errors
}

# Live Watch Mode
run_watch_mode() {
  local interval="${1:-5}"
  echo -e "${C_BLUE}Starting UCA Watch Mode... Press Ctrl+C to exit.${C_RESET}"
  while true; do
    printf "\033[2J\033[H"
    show_status_dashboard 0
    echo -e " ${C_BOLD}${C_GREEN}Live Watch Mode${C_RESET} • Refreshing every ${interval}s • $(date +'%H:%M:%S') (Press Ctrl+C to quit)\n"
    sleep "$interval"
  done
}

# Log Viewer
view_logs() {
  local errors_only="${1:-0}" follow="${2:-0}"
  local target="$LOG_FILE"
  [ "$errors_only" -eq 1 ] && target="$ERROR_LOG_FILE"

  if [ ! -f "$target" ]; then
    echo -e "${C_YELLOW}No log file found at $target${C_RESET}"
    return 0
  fi

  echo -e "\n\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m"
  echo -e " ${C_BOLD}${C_BLUE}UCA LOG VIEWER${C_RESET} — $target"
  echo -e "\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m\n"

  if [ "$follow" -eq 1 ]; then
    tail -n 30 -f "$target"
  else
    tail -n 40 "$target" | while IFS= read -r line; do
      if grep -qi "error\|warning" <<< "$line"; then
        echo -e "${C_YELLOW}$line${C_RESET}"
      elif grep -qi "updated\|success" <<< "$line"; then
        echo -e "${C_GREEN}$line${C_RESET}"
      else
        echo "$line"
      fi
    done
  fi
  echo -e "\n\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m\n"
}

# Doctor Diagnostics
run_doctor() {
  echo -e "\n\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m"
  echo -e " ${C_BOLD}${C_BLUE}UCA DOCTOR${C_RESET} — Harness & Environment Diagnostics"
  echo -e "\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m\n"

  # 1. Bash Shell
  echo -e "  ${C_GREEN}✔${C_RESET} Shell runtime: ${C_BOLD}Bash $BASH_VERSION${C_RESET} ($SHELL)"

  # 2. Charmbracelet Gum
  if command -v gum &>/dev/null; then
    local gv
    gv=$(gum --version 2>/dev/null || echo "installed")
    echo -e "  ${C_GREEN}✔${C_RESET} Charmbracelet Gum: ${C_GREEN}Found${C_RESET} ($gv)"
  else
    echo -e "  ${C_GRAY}•${C_RESET} Charmbracelet Gum: ${C_GRAY}Not in PATH (ANSI fallback active)${C_RESET}"
  fi

  # 3. State storage
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  if [ -w "$STATE_DIR" ]; then
    echo -e "  ${C_GREEN}✔${C_RESET} State storage: $STATE_DIR (writable=true)"
  else
    echo -e "  ${C_RED}✗${C_RESET} State storage: $STATE_DIR (not writable)"
  fi

  # 4. Disk Space Safety
  local free_mb free_gb
  free_mb=$(get_free_disk_mb "$HOME")
  free_gb=$(awk "BEGIN {printf \"%.1f\", $free_mb / 1024}")
  if [ "$free_mb" -lt 50 ]; then
    echo -e "  ${C_RED}✗${C_RESET} Disk Space Safety: ${C_BOLD}${C_RED}${free_mb} MB free${C_RESET} on $HOME (CRITICAL - Minimum required: ${MIN_FREE_DISK_MB} MB)"
  elif [ "$free_mb" -lt "$MIN_FREE_DISK_MB" ]; then
    echo -e "  ${C_YELLOW}⚠️${C_RESET} Disk Space Safety: ${C_BOLD}${C_YELLOW}${free_mb} MB free${C_RESET} on $HOME (Warning - Below threshold of ${MIN_FREE_DISK_MB} MB)"
  else
    echo -e "  ${C_GREEN}✔${C_RESET} Disk Space Safety: ${C_BOLD}${C_GREEN}${free_gb} GB free${C_RESET} on $HOME (Min safety threshold: ${MIN_FREE_DISK_MB} MB)"
  fi

  # 5. Background Service
  local srv_info srv_state srv_detail
  srv_info=$(get_service_status)
  srv_state="${srv_info%%|*}"
  srv_detail="${srv_info##*|}"
  if [ "$srv_state" = "ACTIVE" ]; then
    echo -e "  ${C_GREEN}✔${C_RESET} 3-Hour Auto-Updater: ${C_BOLD}${C_GREEN}${srv_detail}${C_RESET}"
  else
    echo -e "  ${C_YELLOW}⚠️${C_RESET} 3-Hour Auto-Updater: ${C_YELLOW}${srv_detail}${C_RESET} (run 'uca service install' to enable)"
  fi

  # 6. Harness Integrity Checks
  echo -e "\n  ${C_BOLD}Harness Integrity & Smoke Checks:${C_RESET}"
  check_harness_doc() {
    local name="$1" key="$2" bin_cand="$3"
    local bin_path=""
    if command -v "$bin_cand" &>/dev/null; then
      bin_path=$(command -v "$bin_cand")
    elif [ -x "$HOME/.local/bin/$bin_cand" ]; then
      bin_path="$HOME/.local/bin/$bin_cand"
    elif [ -x "$HOME/.bun/bin/$bin_cand" ]; then
      bin_path="$HOME/.bun/bin/$bin_cand"
    fi

    if [ -n "$bin_path" ]; then
      local v smoke_st
      v=$(get_harness_version "$key")
      [ -z "$v" ] && v="unknown"
      if smoke_test_harness "$key"; then
        smoke_st="${C_GREEN}Ready${C_RESET}"
      else
        smoke_st="${C_YELLOW}Warning${C_RESET}"
      fi
      local p_name p_bin p_ver
      p_name=$(pad_str "$name" 20)
      p_bin=$(pad_str "$bin_path" 38)
      p_ver=$(pad_str "$v" 14)
      echo -e "    ${C_GREEN}✔${C_RESET} ${p_name} ${C_GRAY}${p_bin}${C_RESET} Version: ${C_BOLD}${p_ver}${C_RESET} Smoke: $smoke_st"
    else
      echo -e "    ${C_GRAY}•${C_RESET} $(pad_str "$name" 20) ${C_GRAY}Binary not installed${C_RESET}"
    fi
  }

  check_harness_doc "Claude Code"       "claude" "claude"
  check_harness_doc "OpenAI Codex"      "codex"  "codex"
  check_harness_doc "Google Antigravity" "agy"    "agy"
  check_harness_doc "xAI Grok"          "grok"   "grok"
  check_harness_doc "OMP"               "omp"    "omp"

  echo -e "\n\033[38;5;39m════════════════════════════════════════════════════════════════════════════\033[0m\n"
}

# Background Service Installer
install_service() {
  echo -e "\n${C_BOLD}${C_BLUE}Configuring UCA 3-hour background scheduler...${C_RESET}"
  if [ "$(uname -s)" = "Darwin" ] && command -v launchctl &>/dev/null; then
    mkdir -p "$LAUNCHD_DIR"
    local current_user="${USER:-$(whoami 2>/dev/null || echo "user")}"
    local plist_label="com.${current_user}.uca"
    local plist_path="$LAUNCHD_DIR/${plist_label}.plist"
    local path_env="$HOME/.local/bin:$HOME/.bun/bin:$HOME/.grok/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

    cat > "$plist_path" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${plist_label}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${HOME}/.local/bin/uca</string>
        <string>--quiet</string>
        <string>--notify</string>
    </array>
    <key>StartInterval</key>
    <integer>10800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${STATE_DIR}/uca.log</string>
    <key>StandardErrorPath</key>
    <string>${STATE_DIR}/uca-error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>${path_env}</string>
        <key>HOME</key>
        <string>${HOME}</string>
    </dict>
</dict>
</plist>
EOF
    launchctl unload "$plist_path" 2>/dev/null || true
    launchctl load -w "$plist_path" 2>/dev/null || true
    echo -e "  ${C_GREEN}✔${C_RESET} Registered launchd agent ${C_BOLD}${plist_label}${C_RESET} (every 3 hours)"
  elif command -v systemctl &>/dev/null; then
    mkdir -p "$SYSTEMD_USER_DIR"
    local service_file="$SYSTEMD_USER_DIR/uca.service"
    local timer_file="$SYSTEMD_USER_DIR/uca.timer"

    cat > "$service_file" <<EOF
[Unit]
Description=Universal Coding Agent Harness Auto-Updater (UCA)
After=network-online.target default.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=$HOME/.local/bin/uca --quiet --notify
TimeoutStartSec=600
Restart=no
StandardOutput=journal
StandardError=journal
Environment=HOME=$HOME
Environment=PATH=$HOME/.local/bin:$HOME/.bun/bin:$HOME/.grok/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EOF

    cat > "$timer_file" <<EOF
[Unit]
Description=Universal Coding Agent Harness Auto-Updater Timer (every 3 hours)

[Timer]
OnCalendar=*-*-* 00,03,06,09,12,15,18,21:00:00
OnBootSec=5min
Persistent=true
RandomizedDelaySec=180

[Install]
WantedBy=timers.target
EOF
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user enable --now uca.timer 2>/dev/null || true
    echo -e "  ${C_GREEN}✔${C_RESET} Enabled systemd user timer ${C_BOLD}uca.timer${C_RESET} (every 3 hours)"
  fi
}

# Uninstaller
run_uninstaller() {
  local purge="${1:-0}" force="${2:-0}"
  echo -e "\n\033[38;5;214m════════════════════════════════════════════════════════════════════════════\033[0m"
  echo -e " ${C_BOLD}${C_YELLOW}UCA UNINSTALLER${C_RESET} — Clean Removal Wizard"
  echo -e "\033[38;5;214m════════════════════════════════════════════════════════════════════════════\033[0m\n"

  if [ "$force" -eq 0 ]; then
    if has_gum; then
      if ! gum confirm "Are you sure you want to completely uninstall UCA and its background services?"; then
        echo -e "${C_GRAY}Uninstallation aborted.${C_RESET}"
        return 0
      fi
    else
      echo -ne "\033[38;5;214mAre you sure you want to completely uninstall UCA and its background services? [y/N]: \033[0m"
      read -r ans
      case "$ans" in
        y|Y|yes|Yes|YES) ;;
        *) echo -e "${C_GRAY}Uninstallation aborted.${C_RESET}"; return 0 ;;
      esac
    fi
  fi

  # Stop launchd
  if [ "$(uname -s)" = "Darwin" ] && command -v launchctl &>/dev/null; then
    local current_user="${USER:-$(whoami 2>/dev/null || echo "user")}"
    for plist_name in "com.${current_user}.uca.plist" "com.jemanuel.uca.plist" "com.uca.updater.plist"; do
      local plist_file="$LAUNCHD_DIR/$plist_name"
      if [ -f "$plist_file" ]; then
        launchctl unload "$plist_file" 2>/dev/null || true
        rm -f "$plist_file" 2>/dev/null || true
        echo -e "  ${C_GREEN}✔${C_RESET} Removed launchd agent ($plist_name)"
      fi
    done
  fi

  # Stop systemd
  if command -v systemctl &>/dev/null; then
    systemctl --user disable --now uca.timer 2>/dev/null || true
    systemctl --user stop uca.service 2>/dev/null || true
    rm -f "$SYSTEMD_USER_DIR/uca.service" "$SYSTEMD_USER_DIR/uca.timer" 2>/dev/null || true
    systemctl --user daemon-reload 2>/dev/null || true
    echo -e "  ${C_GREEN}✔${C_RESET} Removed systemd units"
  fi

  # Clean aliases
  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.config/fish/config.fish"; do
    if [ -f "$rc" ] && grep -q "alias ucas=" "$rc" 2>/dev/null; then
      sed -i.bak '/alias ucas=/d; /alias uca=/d' "$rc" 2>/dev/null || true
      rm -f "${rc}.bak" 2>/dev/null || true
      echo -e "  ${C_GREEN}✔${C_RESET} Removed aliases from $rc"
    fi
  done

  # Purge state directory if requested
  if [ "$purge" -eq 1 ] && [ -d "$STATE_DIR" ]; then
    rm -rf "$STATE_DIR" 2>/dev/null || true
    echo -e "  ${C_GREEN}✔${C_RESET} Purged state directory ($STATE_DIR)"
  fi

  # Remove binaries
  for b in "$HOME/.local/bin/uca" "$HOME/.local/bin/ucas" "/usr/local/bin/uca" "/usr/local/bin/ucas"; do
    if [ -f "$b" ] || [ -L "$b" ]; then
      rm -f "$b" 2>/dev/null || true
      echo -e "  ${C_GREEN}✔${C_RESET} Removed $b"
    fi
  done

  echo -e "\n${C_GREEN}${C_BOLD}✔ UCA has been cleanly uninstalled.${C_RESET}\n"
}

# Main CLI Router
main() {
  local prog_name
  prog_name=$(basename "$0")
  
  # Invocation as ucas or uca status
  if [ "$prog_name" = "ucas" ] || { [ $# -gt 0 ] && [[ "$1" =~ ^(status|s|st|-s|--status)$ ]]; }; then
    shift 2>/dev/null || true
    local json_m=0
    for a in "$@"; do
      case "$a" in
        --json) json_m=1 ;;
        --no-gum) NO_GUM=1 ;;
        -w|--watch)
          local int=5
          shift 2>/dev/null || true
          [ -n "${1:-}" ] && [[ "$1" =~ ^[0-9]+$ ]] && int="$1"
          run_watch_mode "$int"
          return 0
          ;;
        -h|--help)
          echo "Usage: ucas [OPTIONS]"
          echo ""
          echo "Options:"
          echo "  -w, --watch [SEC]  Interactive auto-refreshing live dashboard (default: 5s)"
          echo "  -f, --fast         Probe versions in parallel (ultra-fast sub-second refresh)"
          echo "  --json             Output status in JSON format"
          echo "  --no-gum           Disable gum styling and use ANSI fallback"
          echo "  -h, --help         Show this help message"
          return 0
          ;;
      esac
    done
    show_status_dashboard "$json_m"
    return 0
  fi

  # Subcommands
  if [ $# -gt 0 ]; then
    case "$1" in
      doctor|doc|--doctor)
        run_doctor
        return 0
        ;;
      logs|log|--logs)
        shift
        local err_m=0 fol_m=0
        for a in "$@"; do
          [ "$a" = "-e" ] || [ "$a" = "--errors" ] && err_m=1
          [ "$a" = "-f" ] || [ "$a" = "--follow" ] && fol_m=1
        done
        view_logs "$err_m" "$fol_m"
        return 0
        ;;
      uninstall|--uninstall|remove)
        shift
        local p_purge=0 p_force=0
        for a in "$@"; do
          [ "$a" = "--purge" ] && p_purge=1
          [ "$a" = "-y" ] || [ "$a" = "--yes" ] && p_force=1
        done
        run_uninstaller "$p_purge" "$p_force"
        return 0
        ;;
      service|--service)
        shift
        local action="${1:-install}"
        if [ "$action" = "install" ] || [ "$action" = "enable" ]; then
          install_service
        else
          get_service_status
        fi
        return 0
        ;;
      check|--check)
        show_status_dashboard 0
        return 0
        ;;
      -h|--help|help)
        echo "UCA — Universal Coding Agent Harness Updater & Version Tracker"
        echo ""
        echo "Usage:"
        echo "  uca                 Update all agent harnesses (claude, codex, agy, grok, omp)"
        echo "  ucas                Show status breakdown, version changes, and schedule"
        echo "  ucas -w, --watch    Interactive live auto-refreshing dashboard"
        echo "  uca <harness>       Update specific harness (e.g. 'uca omp', 'uca claude')"
        echo "  uca doctor          Run preflight diagnostics & self-test"
        echo "  uca logs            Inspect update logs (--errors, --follow)"
        echo "  uca service install Install 3-hour background auto-updater service"
        echo "  uca service status  Show background service status"
        echo "  uca uninstall       Cleanly remove UCA, timers, and aliases (--purge)"
        echo "  uca check           Probe versions without running updates"
        echo ""
        echo "Options:"
        echo "  -q, --quiet            Minimal output (for automated / cron / service runs)"
        echo "  --notify               Dispatch desktop notification on version change"
        echo "  --no-smoke-test        Skip post-update verification guard"
        echo "  --ignore-disk-space    Bypass free disk space safety threshold"
        echo "  --min-disk-mb <N>      Set minimum free disk space threshold (default: 500 MB)"
        echo "  --dry-run              Check versions without applying updates"
        echo "  --no-gum               Disable gum styling and use ANSI fallback"
        echo "  --json                 Output status in JSON format"
        echo "  -h, --help             Show this help message"
        return 0
        ;;
    esac
  fi

  # Flags parsing for update run
  local q_flag=0 dry_flag=0 notif_flag=0 smoke_flag=1 ign_disk=0 min_d="$MIN_FREE_DISK_MB" target=""

  while [ $# -gt 0 ]; do
    case "$1" in
      -q|--quiet)          q_flag=1; notif_flag=1 ;;
      --dry-run)           dry_flag=1 ;;
      --notify)            notif_flag=1 ;;
      --no-smoke-test)     smoke_flag=0 ;;
      --no-gum)            NO_GUM=1 ;;
      --ignore-disk-space) ign_disk=1 ;;
      --min-disk-mb=*)     min_d="${1#*=}" ;;
      --min-disk-mb)       shift; min_d="$1" ;;
      claude|codex|agy|grok|omp) target="$1" ;;
      all) target="" ;;
    esac
    shift 2>/dev/null || break
  done

  run_all_updates "$target" "$q_flag" "$dry_flag" "$notif_flag" "$smoke_flag" "$ign_disk" "$min_d"
}

main "$@"
