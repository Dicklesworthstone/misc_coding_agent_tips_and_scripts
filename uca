        <string>--quiet</string>
        <string>--notify</string>
    </array>
    <key>StartInterval</key>
    <integer>10800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{STATE_DIR}/uca.log</string>
    <key>StandardErrorPath</key>
    <string>{STATE_DIR}/uca-error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{path_env}</string>
        <key>HOME</key>
        <string>{Path.home()}</string>
    </dict>
</dict>
</plist>
"""
    with open(plist_path, "w", encoding="utf-8") as f:
        f.write(plist_content)
        
    print(f"{c('✔', ANSI.GREEN)} Wrote {plist_path}")
    
    # Also write systemd units in ~/.config/systemd/user/ so they exist if synced
    try:
        SYSTEMD_USER_DIR.mkdir(parents=True, exist_ok=True)
        service_file = SYSTEMD_USER_DIR / "uca.service"
        timer_file = SYSTEMD_USER_DIR / "uca.timer"
        service_content = f"""[Unit]
Description=Universal Coding Agent Harness Auto-Updater (UCA)
Documentation=https://github.com/Dicklesworthstone
After=network-online.target default.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/uca --quiet --notify
TimeoutStartSec=600
Restart=no
StandardOutput=journal
StandardError=journal
Environment=HOME=%h
Environment=PATH=%h/.local/bin:%h/.bun/bin:%h/.grok/bin:%h/.cargo/bin:/opt/homebrew/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
"""
        timer_content = """[Unit]
Description=Universal Coding Agent Harness Auto-Updater Timer (every 3 hours)
Documentation=https://github.com/Dicklesworthstone

[Timer]
OnCalendar=*-*-* 00,03,06,09,12,15,18,21:00:00
OnBootSec=5min
Persistent=true
RandomizedDelaySec=180

[Install]
WantedBy=timers.target
"""
        with open(service_file, "w", encoding="utf-8") as f:
            f.write(service_content)
        with open(timer_file, "w", encoding="utf-8") as f:
            f.write(timer_content)
        print(f"{c('✔', ANSI.GREEN)} Wrote {service_file} & {timer_file} (systemd user units)")
    except Exception:
        pass

    try:
        subprocess.run(["launchctl", "unload", str(plist_path)], stderr=subprocess.DEVNULL)
        subprocess.run(["launchctl", "load", "-w", str(plist_path)], check=True)
        print(f"{c('✔', ANSI.GREEN)} Loaded launchd agent {c(plist_label, ANSI.BOLD)} (runs every 3 hours)")
        return True
    except Exception as e:
        print(f"{c('⚠️', ANSI.YELLOW)} launchctl command failed: {e}")
        return False

def install_service() -> None:
    print(f"\n{c('Setting up UCA 3-hour background auto-updater...', ANSI.BLUE, ANSI.BOLD)}")
    if shutil.which("systemctl"):
        install_systemd_service()
    elif shutil.which("launchctl"):
        install_launchd_service()
    else:
        print(c("Neither systemd nor launchd detected on this system.", ANSI.YELLOW))

def run_uninstaller(purge: bool = False, force: bool = False) -> None:
    """Robust in-binary uninstaller tearing down services, symlinks, aliases, and state."""
    print(f"\n{c('═' * 76, ANSI.YELLOW)}")
    print(f" {c('UCA UNINSTALLER', ANSI.BOLD, ANSI.YELLOW)} — Clean Removal Wizard")
    print(f"{c('═' * 76, ANSI.YELLOW)}\n")

    if not force:
        if has_gum():
            cmd = ["gum", "confirm", "Are you sure you want to completely uninstall UCA and its background services?"]
            if subprocess.run(cmd).returncode != 0:
                print(c("Uninstallation aborted.", ANSI.GRAY))
                return
        else:
            ans = input("Are you sure you want to completely uninstall UCA and its background services? [y/N]: ").strip().lower()
            if ans not in ["y", "yes"]:
                print(c("Uninstallation aborted.", ANSI.GRAY))
                return

    # 1. Teardown launchd
    if shutil.which("launchctl"):
        username = os.environ.get("USER") or Path.home().name
        for plist_name in [f"com.{username}.uca.plist", "com.jemanuel.uca.plist", "com.uca.updater.plist"]:
            plist_file = LAUNCHD_DIR / plist_name
            if plist_file.exists():
                subprocess.run(["launchctl", "unload", str(plist_file)], stderr=subprocess.DEVNULL)
                try:
                    plist_file.unlink()
                    print(f"  {c('✔', ANSI.GREEN)} Removed launchd agent ({plist_name})")
                except Exception:
                    pass

    # 2. Teardown systemd
    if shutil.which("systemctl"):
        subprocess.run(["systemctl", "--user", "disable", "--now", "uca.timer"], stderr=subprocess.DEVNULL)
        subprocess.run(["systemctl", "--user", "stop", "uca.service"], stderr=subprocess.DEVNULL)
        for unit in [SYSTEMD_USER_DIR / "uca.service", SYSTEMD_USER_DIR / "uca.timer"]:
            if unit.exists():
                try:
                    unit.unlink()
                    print(f"  {c('✔', ANSI.GREEN)} Removed systemd unit ({unit.name})")
                except Exception:
                    pass
        subprocess.run(["systemctl", "--user", "daemon-reload"], stderr=subprocess.DEVNULL)

    # 3. Remove aliases from shell configs
    for shell_rc in [Path.home() / ".zshrc", Path.home() / ".bashrc", Path.home() / ".config" / "fish" / "config.fish"]:
        if shell_rc.exists():
            try:
                with open(shell_rc, "r", encoding="utf-8") as f:
                    lines = f.readlines()
                new_lines = [l for l in lines if "alias ucas=" not in l and "alias uca=" not in l]
                if len(new_lines) != len(lines):
                    with open(shell_rc, "w", encoding="utf-8") as f:
                        f.writelines(new_lines)
                    print(f"  {c('✔', ANSI.GREEN)} Removed aliases from {shell_rc}")
            except Exception:
                pass

    # 4. Remove state directory if purge requested
    if purge and STATE_DIR.exists():
        try:
            shutil.rmtree(STATE_DIR)
            print(f"  {c('✔', ANSI.GREEN)} Purged state directory ({STATE_DIR})")
        except Exception:
            pass

    # 5. Remove binaries and symlinks
    bin_targets = [
        Path.home() / ".local" / "bin" / "uca",
        Path.home() / ".local" / "bin" / "ucas",
        Path("/usr/local/bin/uca"),
        Path("/usr/local/bin/ucas"),
    ]
    for b in bin_targets:
        if b.exists() or b.is_symlink():
            try:
                b.unlink()
                print(f"  {c('✔', ANSI.GREEN)} Removed {b}")
            except Exception:
                pass

    print(f"\n{c('✔ UCA has been cleanly uninstalled.', ANSI.GREEN, ANSI.BOLD)}\n")

def main() -> None:
    global NO_GUM, FORCE_COLOR
    prog_name = os.path.basename(sys.argv[0])
    raw_args = sys.argv[1:]

    # Signal handlers for clean exit
    def sig_handler(signum, frame):
        sys.exit(128 + signum)
    signal.signal(signal.SIGTERM, sig_handler)
    signal.signal(signal.SIGHUP, sig_handler)

    if "--no-gum" in raw_args:
        NO_GUM = True
        raw_args = [a for a in raw_args if a != "--no-gum"]

    # Status / UCAS invocation
    if prog_name == "ucas" or (raw_args and raw_args[0] in ["status", "s", "st", "-s", "--status"]):
        if "-h" in raw_args or "--help" in raw_args:
            print("""UCAS — Universal Coding Agent Harness Dashboard

Usage:
  ucas                Show status dashboard, recent version changes, and schedule
  ucas -w, --watch    Interactive live auto-refreshing dashboard
  ucas -f, --fast     Probe versions in parallel (ultra-fast sub-second refresh)
  ucas --json         Output status in machine-readable JSON format
  ucas --no-gum       Disable gum styling and use ANSI fallback
  ucas -h, --help     Show this help message
""")
            return
        if "-w" in raw_args or "--watch" in raw_args:
            interval = 5
            for a in raw_args:
                if a.isdigit():
                    interval = max(1, int(a))
            run_watch_mode(interval_sec=interval)
            return
        json_mode = "--json" in raw_args
        fast_mode = "-f" in raw_args or "--fast" in raw_args
        print_status_dashboard(json_mode=json_mode, fast=fast_mode)
        return

    # Check for doctor command
    if raw_args and raw_args[0] in ["doctor", "doc", "--doctor", "--verify"]:
        run_doctor()
        return

    # Check for logs command
    if raw_args and raw_args[0] in ["logs", "log", "--logs"]:
        errors_only = "-e" in raw_args or "--errors" in raw_args
        follow_mode = "-f" in raw_args or "--follow" in raw_args
        view_logs(errors_only=errors_only, follow=follow_mode)
        return

    # Check for uninstall command
    if raw_args and raw_args[0] in ["uninstall", "--uninstall", "remove"]:
        purge = "--purge" in raw_args
        force = "-y" in raw_args or "--yes" in raw_args
        run_uninstaller(purge=purge, force=force)
        return

    # Check for service command
    if raw_args and raw_args[0] in ["service", "--service", "--install-service"]:
        action = "install"
        if len(raw_args) > 1 and raw_args[1] in ["status", "install", "enable", "disable"]:
            action = raw_args[1]
        elif raw_args[0] == "--install-service":
            action = "install"
            
        if action in ["install", "enable"]:
            install_service()
        else:
            status_data = get_service_status()
            print(f"Service Type: {status_data['type']}")
            print(f"Active: {status_data['active']}")
            print(f"Detail: {status_data['detail']}")
        return

    # Check for check command
    if raw_args and raw_args[0] in ["check", "--check"]:
        print_status_dashboard(json_mode="--json" in raw_args, fast=True)
        return

    # Parse flags
    quiet = "-q" in raw_args or "--quiet" in raw_args
    notify = "--notify" in raw_args or quiet  # Send notification in background quiet mode
    smoke_test = "--no-smoke-test" not in raw_args
    dry_run = "--dry-run" in raw_args
    help_flag = "-h" in raw_args or "--help" in raw_args

    if help_flag:
        print("""UCA — Universal Coding Agent Harness Updater & Version Tracker

Usage:
  uca                 Update all agent harnesses (claude, codex, agy, grok, omp)
  ucas                Show status breakdown, version changes, and schedule
  ucas -w, --watch    Interactive live auto-refreshing dashboard
  uca <harness>       Update specific harness (e.g. 'uca omp', 'uca claude')
  uca doctor          Run preflight diagnostics & self-test
  uca logs            Inspect update logs (--errors, --follow)
  uca service install Install 3-hour background auto-updater service
  uca service status  Show background service status
  uca uninstall       Cleanly remove UCA, timers, and aliases (--purge)
  uca check           Probe versions without running updates

Options:
  -q, --quiet         Minimal output (for automated / cron / service runs)
  --notify            Dispatch desktop notification on version change
  --no-smoke-test     Skip post-update verification guard
  --dry-run           Check versions without applying updates
  --no-gum            Disable gum styling and use ANSI fallback
  --json              Output status in JSON format
  -h, --help          Show this help message
""")
        return

    # Filter out flags to find target harnesses
    known_harness_keys = {cfg["key"] for cfg in HARNESS_CONFIGS}
    targets = []
    for arg in raw_args:
        if arg.startswith("-"):
            continue
        if arg.lower() in ["update", "run"]:
            continue
        if arg.lower() in known_harness_keys or arg.lower() in ["all"]:
            if arg.lower() != "all":
                targets.append(arg.lower())
        else:
            matched = False
            for k in known_harness_keys:
                if k.startswith(arg.lower()):
                    targets.append(k)
                    matched = True
                    break
            if not matched:
                print(c(f"Unknown harness or command: '{arg}'. Available: {', '.join(sorted(known_harness_keys))}", ANSI.YELLOW))

    code = run_all_updates(
        target_keys=targets if targets else None,
        quiet=quiet,
        dry_run=dry_run,
        notify=notify,
        smoke_test=smoke_test,
    )
    sys.exit(code)

if __name__ == "__main__":
    main()
