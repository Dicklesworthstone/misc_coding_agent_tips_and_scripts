    print(f"\n{c('═' * 76, ANSI.BLUE)}")
    print(f" {c('UCA LOG VIEWER', ANSI.BOLD, ANSI.BLUE)} — {target_file}")
    print(f"{c('═' * 76, ANSI.BLUE)}\n")

    if follow:
        try:
            subprocess.run(["tail", "-n", "30", "-f", str(target_file)])
        except KeyboardInterrupt:
            print("\nLog tail stopped.")
    else:
        try:
            with open(target_file, "r", encoding="utf-8", errors="replace") as f:
