# ANSI Fallback Colors
class ANSI:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    ITALIC = "\033[3m"
    BLUE = "\033[38;5;39m"
    GREEN = "\033[38;5;42m"
    YELLOW = "\033[38;5;214m"
    RED = "\033[38;5;196m"
    MAGENTA = "\033[38;5;212m"
    GRAY = "\033[38;5;245m"
    WHITE = "\033[38;5;252m"

ANSI_STRIP_RE = re.compile(r"\033\[[0-9;]*[a-zA-Z]")

def strip_ansi(s: str) -> str:
    return ANSI_STRIP_RE.sub("", s)

def visible_len(s: str) -> int:
    return len(strip_ansi(s))

def pad_str(s: str, width: int, align: str = "left") -> str:
    vlen = visible_len(s)
    pad = max(0, width - vlen)
    if align == "right":
        return " " * pad + s
    elif align == "center":
        left = pad // 2
        right = pad - left
        return " " * left + s + " " * right
    return s + " " * pad

# Global Settings
NO_GUM = False
FORCE_COLOR = False

def use_color() -> bool:
    if os.environ.get("NO_COLOR") or os.environ.get("TERM") == "dumb":
        return False
    return sys.stdout.isatty() or FORCE_COLOR

def c(text: str, *styles: str) -> str:
    if not use_color():
        return strip_ansi(str(text))
    return "".join(styles) + str(text) + ANSI.RESET

def has_gum() -> bool:
    if NO_GUM:
        return False
    if os.environ.get("NO_COLOR") or os.environ.get("TERM") == "dumb":
        return False
    gum_bin = shutil.which("gum")
    return bool(gum_bin and (sys.stdout.isatty() or FORCE_COLOR))

def gum_style(*args: str, text: str = "") -> str:
    gum_bin = shutil.which("gum")
    if not gum_bin:
        return text
    cmd = [gum_bin, "style"] + list(args)
    if text:
        cmd.append(text)
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        return r.stdout.rstrip("\n")
    except Exception:
        return text

# Atomic Locking with Stale PID Detection & Signal Trap
class AtomicLock:
    def __init__(self, lock_dir: Path):
        self.lock_dir = lock_dir
        self.acquired = False

    def acquire(self) -> bool:
        self.lock_dir.parent.mkdir(parents=True, exist_ok=True)
        try:
            os.mkdir(self.lock_dir)
            self.acquired = True
            with open(self.lock_dir / "pid", "w", encoding="utf-8") as f:
                f.write(str(os.getpid()))
            return True
        except FileExistsError:
            # Check stale lock
            pid_file = self.lock_dir / "pid"
            if pid_file.exists():
                try:
                    with open(pid_file, "r", encoding="utf-8") as f:
                        old_pid = int(f.read().strip())
                    os.kill(old_pid, 0)
                    return False
                except (ValueError, ProcessLookupError, PermissionError):
                    pass
            
            # Clean up stale lock
            try:
                if pid_file.exists():
                    pid_file.unlink()
                os.rmdir(self.lock_dir)
                os.mkdir(self.lock_dir)
                self.acquired = True
                with open(self.lock_dir / "pid", "w", encoding="utf-8") as f:
                    f.write(str(os.getpid()))
                return True
            except Exception:
                return False

    def release(self) -> None:
        if self.acquired and self.lock_dir.exists():
            try:
                pid_file = self.lock_dir / "pid"
                if pid_file.exists():
                    pid_file.unlink()
                os.rmdir(self.lock_dir)
            except Exception:
                pass
            self.acquired = False

    def __enter__(self):
        if not self.acquire():
            print(c("⚠ Another UCA process is currently running. Skipping execution.", ANSI.YELLOW), file=sys.stderr)
            sys.exit(0)
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        self.release()

