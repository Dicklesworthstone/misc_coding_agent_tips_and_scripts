def run_watch_mode(interval_sec: int = 5) -> None:
    """Interactive live dashboard watch mode."""
    print(c("Starting UCA Watch Mode... Press Ctrl+C to exit.", ANSI.BLUE))
    try:
        while True:
            # Clear screen ANSI escape
            sys.stdout.write("\033[2J\033[H")
            sys.stdout.flush()
            print_status_dashboard(fast=True)
            print(f" {c('Live Watch Mode', ANSI.BOLD, ANSI.GREEN)} • Refreshing every {interval_sec}s • {datetime.now().strftime('%H:%M:%S')} (Press Ctrl+C to quit)\n")
            time.sleep(interval_sec)
    except KeyboardInterrupt:
        print(f"\n{c('Watch mode stopped.', ANSI.GRAY)}")

def view_logs(errors_only: bool = False, follow: bool = False) -> None:
    """Views recent update logs or tails log file."""
    target_file = ERROR_LOG_FILE if errors_only else LOG_FILE
    if not target_file.exists():
